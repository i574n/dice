///> zig
/// # dice (Dice)
///> fsharp
///> typescript
///> python
///> lua
///> c
///> zig
///> gleam
///> pascal
///> rust
test dice_dice static =
    :< testing

:< sm'_operators
:< digest

/// ## face
:| face =
    | One
    | Two
    | Three
    | Four
    | Five
    | Six

:= digit \* t {number}. (f : face) : t =
    conv (!!!!UnionTag(f) : i32)

:= pips (f : face) : u8 =
    digit f + 1u8

:= face_of_digit (d : i32) : face =
    ?= d ?|
    | 0 => One
    | 1 => Two
    | 2 => Three
    | 3 => Four
    | 4 => Five
    | _ => Six

:= face_of_pips (p : u8) : option face =
    ? p >= 1u8 && p <= 6u8 ?> Some (face_of_digit (conv (p - 1u8))) |: None

:= face_of_byte (b : u8) : option face =
    ? b < 252u8 ?> Some (face_of_digit (conv (b % 6u8))) |: None

///> zig
test every_face_round_trips_through_its_pips =
    := ~low = 0u8
    (
        listm.map (pips >> face_of_pips) [ One; Two; Three; Four; Five; Six ]
        |> listm.map (optionm.map pips),
        face_of_pips low,
        face_of_pips (low + 7u8)
    )
    |> _assert_eq ([ Some 1u8; Some 2; Some 3; Some 4; Some 5; Some 6 ], None, None)

:= face_counts () : array i32 =
    := counts : array i32 = create 7
    :~ ^ clear (i : i32) : () =
        ? i < 7 ?>
            set counts i 0
            clear (i + 1)
    clear 0
    :~ ^ go (b : i32) : () =
        ? b <= 255 ?>
            := slot =
                ?= face_of_byte (conv b) ?|
                | Some f => digit f
                | None => 6i32
            set counts slot (index counts slot + 1)
            go (b + 1)
    go 0
    counts

///> zig
test every_face_takes_the_same_share_of_the_bytes =
    face_counts ()
    |> _assert_eq (;[ 42i32; 42; 42; 42; 42; 42; 4 ] : array i32)

/// ## bound
:! bound t = t

:| bound_error t =
    | EmptyRange
    | AboveLargest : t * t

:= ^ largest_from \* t {number}. (p : t) : t =
    ? p > (limit.max : t) / 6 ?> p |: largest_from (p * 6)

:= largest_bound \* t {number}. () : t =
    largest_from 1

:= bound_of \* t {number}. (max : t) : result (bound t) (bound_error t) =
    ? max < 1 ?> Error EmptyRange
    |? max > largest_bound () ?> Error (AboveLargest (max, largest_bound ()))
    |: Ok (bound max)

:= bound_value \* t. ((bound max) : bound t) : t =
    max

:= bound_error_text \* t {number}. (e : bound_error t) : string =
    ?= e ?|
    | EmptyRange => "max must be at least 1"
    | AboveLargest (max, largest) => "max: " ++# #?max ++# " is above the largest supported bound " ++# #?largest

:= dice_count \* t {number}. (b : bound t) : i32 =
    := max = bound_value b
    :~ ^ go (count : i32) (reach : t) : i32 =
        ? reach >= max ?> count |: go (count + 1) (reach * 6)
    ? max = 1 ?> 1 |: go 0 1

///> zig
test largest_bound_is_the_largest_power_of_six_of_the_type =
    ((largest_bound () : i32), (largest_bound () : u64), (largest_bound () : u8))
    |> _assert_eq (362797056i32, 4738381338321616896u64, 216u8)

///> zig
test bound_of_rejects_empty_and_oversized_ranges =
    := ~zero = 0u64
    := ~over = 4738381338321616897u64
    := text (r : result (bound u64) (bound_error u64)) =
        ?= r ?|
        | Ok b => #?(bound_value b)
        | Error e => bound_error_text e
    (text (bound_of zero), text (bound_of over), text (bound_of (zero + 2000u64)))
    |> _assert_eq (
        "max must be at least 1",
        "max: 4738381338321616897 is above the largest supported bound 4738381338321616896",
        "2000"
    )

:= count_of \* t {number}. (max : t) : i32 =
    ?= bound_of max ?|
    | Ok b => dice_count b
    | Error _ => -1

///> zig
test dice_count_is_the_fewest_dice_that_reach_the_bound =
    := ~one = 1i32
    (count_of one, count_of (one * 36), count_of (one * 7777), count_of (one * 362797056), count_of 4738381338321616896u64)
    |> _assert_eq (1i32, 2i32, 6i32, 11i32, 24i32)

test a_raw_number_is_not_a_bound fails ETY-TermError "Unification failure" =
    dice_count 36u64

/// ## hand
:= hand_value \* t {number}. (b : bound t) (count : i32) (hand : list face) : option t =
    := max = bound_value b
    :~ ^ go (left : i32) (faces : list face) (value : t) : option t =
        ? left <= 0
        ?> ? value < max ?> Some (value + 1) |: None
        |:
            ?= faces ?|
            | f :: rest =>
                := d = digit f
                ? d >= max || value > (max - 1 - d) / 6 ?> None |: go (left - 1) rest (value * 6 + d)
            | [] => None
    go count hand 0

:= faces_of_pips (rolls : list u8) : option (list face) =
    :~ ^ go (rolls : list u8) (acc : list face) : option (list face) =
        ?= rolls ?|
        | r :: rest =>
            ?= face_of_pips r ?|
            | Some f => go rest (f :: acc)
            | None => None
        | [] => Some (listm.rev acc)
    go rolls []

:= roll_within_bounds \* t {number}. (max : t) (rolls : list u8) : option t =
    ?= bound_of max, faces_of_pips rolls ?|
    | Ok b, Some hand => hand_value b (listm.length hand) hand
    | _ => None

///> zig
test roll_within_bounds =
    roll_within_bounds 2000i32 [ 1; 5; 4; 4; 5 ]
    |> _assert_eq (Some 995)

///> zig
test roll_within_bounds_2 =
    roll_within_bounds 2000i32 [ 2; 2; 6; 4; 5 ]
    |> _assert_eq (Some 1715)

///> zig
test roll_within_bounds_3 =
    roll_within_bounds 2000i32 [ 4; 1; 1; 2; 3 ]
    |> _assert_eq None

///> zig
test roll_within_bounds_rejects_a_face_that_no_die_has =
    (roll_within_bounds 2000i32 [ 1; 7; 1 ], roll_within_bounds 2000i32 [ 0; 1 ], roll_within_bounds 0i32 [ 1 ])
    |> _assert_eq (None, None, None)

///> zig
test roll_within_bounds_never_overflows_a_long_hand =
    roll_within_bounds 4738381338321616896u64 [ 6; 6; 6; 6; 6; 6; 6; 6; 6; 6; 6; 6; 6; 6; 6; 6; 6; 6; 6; 6; 6; 6; 6; 6; 6; 6; 6 ]
    |> _assert_eq None

:~ ^ faces (from : u8) : list u8 = ? from > 6 ?> [] |: from :: faces (from + 1)

:~ ^ pair_results (firsts : list u8) (acc : list (option i32)) : list (option i32) =
    ?= firsts ?|
    | a :: rest => pair_results rest (listm.fold (\ acc b => roll_within_bounds 20i32 [ a; b ] :: acc) acc (faces 1))
    | [] => acc

:~ ^ occurrences (v : i32) (results : list (option i32)) (n : i32) : i32 =
    ?= results ?|
    | Some x :: rest => occurrences v rest (? x = v ?> n + 1 |: n)
    | None :: rest => occurrences v rest n
    | [] => n

:~ ^ values_seen_once (v : i32) (results : list (option i32)) : bool =
    ? v > 20i32 ?> !+ |: occurrences v results 0 = 1 && values_seen_once (v + 1) results

///> zig
test every_two_roll_sequence_maps_to_one_value_so_accepted_rolls_are_uniform =
    := results = pair_results (faces 1) []
    := rejected = listm.fold (\ n r => ?= r ?| Some _ => n | None => n + 1i32) 0i32 results
    (values_seen_once 1i32 results, rejected) |> _assert_eq (!+, 16i32)

/// ## sources
:? draw_face s : s -> face * s

:! replay = { all : list face; rest : list face }

:= replayed (faces : list face) : replay =
    replay { all = faces; rest = faces }

:+ draw_face replay =
    \ (replay { all rest }) =>
        ?= rest ?|
        | f :: rest => f, replay { all = all; rest = rest }
        | [] =>
            ?= all ?|
            | f :: rest => f, replay { all = all; rest = rest }
            | [] => One, replay { all = all; rest = [] }

:! system = ()

:+ draw_face system =
    \ s => face_of_digit (random' 0i32 6i32), s

:! roller = () -> u8

:~ ^ draw_rolled (roll : () -> u8) : face =
    ?= face_of_pips (roll ()) ?|
    | Some f => f
    | None => draw_rolled roll

:+ draw_face roller =
    \ (roller roll) => draw_rolled roll, roller roll

:! hash_faces h = { hasher : h; digest : array u8; at : i32 }

:= hashed \* h. (hasher : h) (digest : array u8) : hash_faces h =
    hash_faces { hasher = hasher; digest = digest; at = 0 }

:~ ^ draw_hashed \* h {digest_with}. (hasher : h) (digest : array u8) (at : i32) : face * hash_faces h =
    ? at >= length digest
    ?> draw_hashed hasher (digest_with hasher digest) 0
    |:
        ?= face_of_byte (index digest at) ?|
        | Some f => f, hash_faces { hasher = hasher; digest = digest; at = at + 1 }
        | None => draw_hashed hasher digest (at + 1)

:+ draw_face hash_faces h {digest_with} =
    \ (hash_faces { hasher digest at }) => draw_hashed hasher digest at

/// ## roll
:| reroll =
    | Fresh
    | Slide

:~ ^ roll_hand \* s {draw_face}. (count : i32) (hand : list face) (source : s) : list face * s =
    ? count <= 0
    ?> hand, source
    |:
        := f, source = draw_face source
        roll_hand (count - 1) (f :: hand) source

:~ ^ roll_kept \* t {number} s {draw_face}.
    (policy : reroll)
    (b : bound t)
    (count : i32)
    (hand : list face)
    (source : s)
    : t * s
    =
    ?= hand_value b count hand ?|
    | Some value => value, source
    | None =>
        ?= policy ?|
        | Fresh =>
            := hand, source = roll_hand count [] source
            roll_kept policy b count hand source
        | Slide =>
            := f, source = draw_face source
            roll_kept policy b count (f :: hand) source

:~ ^ roll_fresh \* t {number} s {draw_face}. (b : bound t) (count : i32) (source : s) : t * s =
    :~ ^ read (left : i32) (place : t) (value : t) (source : s) : t * s =
        ? left <= 0
        ?> value, source
        |:
            := f, source = draw_face source
            read (left - 1) (place * 6) (value + digit f * place) source
    := value, source = read count 1 0 source
    ? value < bound_value b ?> value + 1, source |: roll_fresh b count source

:= roll \* t {number} s {draw_face}. (policy : reroll) (b : bound t) (source : s) : t * s =
    := count = dice_count b
    ?= policy ?|
    | Fresh => roll_fresh b count source
    | Slide =>
        := hand, source = roll_hand count [] source
        roll_kept policy b count hand source

:= roll_value \* t {number} s {draw_face}. (policy : reroll) (max : t) (source : s) : t =
    ?= bound_of max ?|
    | Ok b => fst (roll policy b source)
    | Error e => failwith (bound_error_text e)

///> zig
test a_replayed_hand_reads_its_newest_die_first =
    roll_value Slide 2000i32 (replayed [ Five; Four; Four; Five; One ])
    |> _assert_eq 995

///> zig
test sliding_keeps_the_newest_dice_after_a_rejection =
    roll_value Slide 2000i32 (replayed [ Five; Four; Four; Five; Two; Two ])
    |> _assert_eq 1678

///> zig
test the_largest_bound_accepts_the_highest_hand =
    roll_value Fresh 4738381338321616896u64 (replayed [ Six ])
    |> _assert_eq 4738381338321616896u64

///> zig
test a_single_die_bound_keeps_only_the_lowest_face =
    roll_value Fresh 1i32 (replayed [ Six; Four; One ])
    |> _assert_eq 1i32

///> zig
test fresh_rerolls_every_die_after_a_rejection =
    roll_value Fresh 20i32 (replayed [ Six; Six; Two; One ])
    |> _assert_eq 2i32

test a_source_without_draw_face_cannot_roll fails ETY-InstanceNotFound "draw_face" =
    roll_value Fresh 6i32 (bound 6i32)

:~ ^ hashed_values (left : i32) (source : hash_faces keccak.spiral_keccak) (acc : list u64) : list u64 =
    ? left <= 0
    ?> listm.rev acc
    |:
        ?= bound_of 2000u64 ?|
        | Ok b =>
            := value, source = roll Fresh b source
            hashed_values (left - 1) source (value :: acc)
        | Error _ => acc

///> zig
test a_keccak_stream_rolls_the_same_values_on_every_backend =
    := ~seed_size = 3i32
    := seed : array u8 = bytes.counting seed_size
    hashed_values 6 (hashed keccak.spiral_keccak seed) []
    |> _assert_eq [ 1295u64; 295; 1135; 1360; 1663; 1972 ]

:~ ^ histogram_misses (policy : reroll) (max : i32) (draws : i32) (seen : list i32) : i32 =
    ? draws <= 0
    ?> listm'.init_series 1i32 max 1i32 |> listm.fold (\ misses v => ? listm.fold (\ found x => found || x = v) !- seen ?> misses |: misses + 1) 0i32
    |:
        := value = roll_value policy max system
        ? value < 1 || value > max ?> -1i32 |: histogram_misses policy max (draws - 1) (value :: seen)

///> rust
///> fsharp
///> typescript
///> python
///> lua
test system_rolls_cover_every_value_and_stay_in_range =
    := ~draws = 3000i32
    (histogram_misses Fresh 10i32 draws [], histogram_misses Slide 10i32 draws [], histogram_misses Fresh 37i32 draws [])
    |> _assert_eq (0i32, 0i32, 0i32)

/// ## rotate_number
:= rotate_number \* t {number}. (max : i64) (n : t) : t =
    (conv n - 1 + max) % max + 1 |> conv

:= rotate_numbers max items =
    items |> stream.map (rotate_number max)

///> rust
///> fsharp
///> typescript
test rotate_numbers =
    listm'.init_series -1 14 1i32
    |> stream.from_list
    |> rotate_numbers 6
    |> stream.to_list
    |> _assert_eq [ 5; 6; 1; 2; 3; 4; 5; 6; 1; 2; 3; 4; 5; 6; 1; 2 ]

/// ## create_sequential_roller
:= create_sequential_roller list =
    := s = list |> listm.rev |> listm.append list |> stream.from_list |> stream.memoize
    := current_index = mut 0i64
    := acc = mut 1
    := len = mut -1
    :~ ^ 루프 () =
        ?= s () |> stream.try_item *current_index ?|
        | Some item =>
            current_index <- *current_index + 1
            item
        | None =>
            ? *len = -1
            ?> len <- *current_index
            acc <-
                ? *acc >= *len
                ?> 1
                |: *acc + 1
            current_index <- *acc - 1
            루프 ()
    루프

///> rust
///> fsharp
///> typescript
test create_sequential_roller =
    := sequential_roll = create_sequential_roller [ 1i32; 2; 3; 4 ]

    arraym.init 50i32 (ignore >> sequential_roll)
    |> _assert_eq (;[ 1; 2; 3; 4; 4; 3; 2; 1; 2; 3; 4; 4; 3; 2; 1; 3; 4; 4; 3; 2; 1; 4; 4; 3; 2; 1;
    4; 3; 2; 1; 3; 2; 1; 2; 1; 1; 1; 2; 3; 4; 4; 3; 2; 1; 2; 3; 4; 4; 3; 2 ] : array i32)

/// ## roll_progressively
:= roll_progressively (roll : () -> u8) (reroll : bool) max =
    roll_value (? reroll ?> Fresh |: Slide) max (roller roll)

///> rust
///> fsharp
///> typescript
test roll_progressively =
    := sequential_roll = create_sequential_roller [ 5u8; 4; 4; 5; 1 ]
    roll_progressively sequential_roll !- 2000i32
    |> _assert_eq 995

///> rust
///> fsharp
///> typescript
test roll_progressively_2 =
    := sequential_roll = create_sequential_roller [ 5u8; 4; 4; 5; 2 ]
    roll_progressively sequential_roll !- 2000i32
    |> _assert_eq 1678

/// ## main

:= main (_args : array_base string) =
    := result = roll_value Fresh 4738381338321616896i64 system
    trace Debug
        \ () => "dice.main"
        \ () => { result }
    0i32

:= main () =
    := rotate_numbers' : i64 -> stream.stream u8 -> stream.stream u8 =
        rotate_numbers

    := create_sequential_roller' :
        list u8
        -> (() -> u8)
        =
        create_sequential_roller

    := roll_progressively' :
        (() -> u8)
        -> bool
        -> u64
        -> u64
        =
        roll_progressively

    := roll_within_bounds' :
        u64
        -> list u8
        -> optionm'.option' u64
        =
        \ a b =>
            roll_within_bounds a b
            |> optionm'.box

    backend_switch {
        Fsharp = \ () => $'let rotate_numbers x = !rotate_numbers' x' : ()
        Rust = \ () => ()
        TypeScript = \ () => ()
        C = \ () => ()
    } : ()
    backend_switch {
        Fsharp = \ () => $'let create_sequential_roller x = !create_sequential_roller' x' : ()
        Rust = \ () => ()
        TypeScript = \ () => ()
        C = \ () => ()
    } : ()
    backend_switch {
        Fsharp = \ () => $'let roll_progressively x = !roll_progressively' x' : ()
        Rust = \ () => ()
        TypeScript = \ () => ()
        C = \ () => ()
    } : ()
    backend_switch {
        Fsharp = \ () => $'let roll_within_bounds x = !roll_within_bounds' x' : ()
        Rust = \ () => ()
        TypeScript = \ () => ()
        C = \ () => ()
    } : ()
    backend_switch {
        Fsharp = \ () => $'let main args = !main args' : ()
        Rust = \ () => main (;[] |> am'.base) |> ignore
        Python = \ () => main (;[] |> am'.base) |> ignore
        TypeScript = \ () => main (;[] |> am'.base) |> ignore
        C = \ () => ()
    } : ()
