## main

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= main (_args : array_base string) =\n    := result = roll_value Fresh 4738381338321616896i64 system\n    trace Debug\n        \\ () => \"dice.main\"\n        \\ () => { result }\n    0i32\n\n:= main () =\n    := rotate_numbers' : i64 -> stream.stream u8 -> stream.stream u8 =\n        rotate_numbers\n\n    := create_sequential_roller' :\n        list u8\n        -> (() -> u8)\n        =\n        create_sequential_roller\n\n    := roll_progressively' :\n        (() -> u8)\n        -> bool\n        -> u64\n        -> u64\n        =\n        roll_progressively\n\n    := roll_within_bounds' :\n        u64\n        -> list u8\n        -> optionm'.option' u64\n        =\n        \\ a b =>\n            roll_within_bounds a b\n            |> optionm'.box\n\n    backend_switch {\n        Fsharp = \\ () => $'let rotate_numbers x = !rotate_numbers' x' : ()\n        Rust = \\ () => ()\n        TypeScript = \\ () => ()\n        C = \\ () => ()\n    } : ()\n    backend_switch {\n        Fsharp = \\ () => $'let create_sequential_roller x = !create_sequential_roller' x' : ()\n        Rust = \\ () => ()\n        TypeScript = \\ () => ()\n        C = \\ () => ()\n    } : ()\n    backend_switch {\n        Fsharp = \\ () => $'let roll_progressively x = !roll_progressively' x' : ()\n        Rust = \\ () => ()\n        TypeScript = \\ () => ()\n        C = \\ () => ()\n    } : ()\n    backend_switch {\n        Fsharp = \\ () => $'let roll_within_bounds x = !roll_within_bounds' x' : ()\n        Rust = \\ () => ()\n        TypeScript = \\ () => ()\n        C = \\ () => ()\n    } : ()\n    backend_switch {\n        Fsharp = \\ () => $'let main args = !main args' : ()\n        Rust = \\ () => main (;[] |> am'.base) |> ignore\n        Python = \\ () => main (;[] |> am'.base) |> ignore\n        TypeScript = \\ () => main (;[] |> am'.base) |> ignore\n        C = \\ () => ()\n    } : ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := main (_args : array_base string) =
      := result = roll_value Fresh 4738381338321616896i64 system
      trace Debug
          \ () => "dice.main"
          \ () => { result }
      0i32

  := main () =
      := rotate_numbers' : i64 -> stream.stream u8 -> stream.stream u8 =
          rotate_numbers

      := create_sequential_roller' :
          list u8
          -> (() -> u8)
          =
          create_sequential_roller

      := roll_progressively' :
          (() -> u8)
          -> bool
          -> u64
          -> u64
          =
          roll_progressively

      := roll_within_bounds' :
          u64
          -> list u8
          -> optionm'.option' u64
          =
          \ a b =>
              roll_within_bounds a b
              |> optionm'.box

      backend_switch {
          Fsharp = \ () => $'let rotate_numbers x = !rotate_numbers' x' : ()
          Rust = \ () => ()
          TypeScript = \ () => ()
          C = \ () => ()
      } : ()
      backend_switch {
          Fsharp = \ () => $'let create_sequential_roller x = !create_sequential_roller' x' : ()
          Rust = \ () => ()
          TypeScript = \ () => ()
          C = \ () => ()
      } : ()
      backend_switch {
          Fsharp = \ () => $'let roll_progressively x = !roll_progressively' x' : ()
          Rust = \ () => ()
          TypeScript = \ () => ()
          C = \ () => ()
      } : ()
      backend_switch {
          Fsharp = \ () => $'let roll_within_bounds x = !roll_within_bounds' x' : ()
          Rust = \ () => ()
          TypeScript = \ () => ()
          C = \ () => ()
      } : ()
      backend_switch {
          Fsharp = \ () => $'let main args = !main args' : ()
          Rust = \ () => main (;[] |> am'.base) |> ignore
          Python = \ () => main (;[] |> am'.base) |> ignore
          TypeScript = \ () => main (;[] |> am'.base) |> ignore
          C = \ () => ()
      } : ()
  """,
  timeout: 300_000
)
```
