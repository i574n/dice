  ///- --test
  ///> rust
  ///> fsharp
  ///> typescript
  ///> python
  ///> lua
  ///> c
  ///> zig
  ///> gleam
  ///> pascal

  := ~five = 5i32
  (outcome_spread five, outcome_spread (five + 2), outcome_spread (five * 4))
  |> _assert_eq ((43i32, 43i32, 1i32), (30i32, 30i32, 6i32), (10i32, 10i32, 16i32))
  """,
  timeout: 300_000
)
