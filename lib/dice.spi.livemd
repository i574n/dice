## create_sequential_roller

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= create_sequential_roller list =\n    := s = list |> listm.rev |> listm.append list |> stream.from_list |> stream.memoize\n    := current_index = mut 0i64\n    := acc = mut 1\n    := len = mut -1\n    :~ ^ 루프 () =\n        ?= s () |> stream.try_item *current_index ?|\n        | Some item =>\n            current_index <- *current_index + 1\n            item\n        | None =>\n            ? *len = -1\n            ?> len <- *current_index\n            acc <-\n                ? *acc >= *len\n                ?> 1\n                |: *acc + 1\n            current_index <- *acc - 1\n            루프 ()\n    루프","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := create_sequential_roller list =
      := s = list |> listm.rev |> listm.append list |> stream.from_list |> stream.memoize
      := current_index = mut 0i64
      := acc = mut 1
      := len = mut -1
      :~ ^ 루프 () =
          ?= s () |> stream.try_item *current_index ?|
          | Some item =>
              current_index <- *current_index + 1
              item
          | None =>
              ? *len = -1
              ?> len <- *current_index
              acc <-
                  ? *acc >= *len
                  ?> 1
                  |: *acc + 1
              current_index <- *acc - 1
              루프 ()
      루프
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> rust\n///> fsharp\n///> typescript\n\n:= sequential_roll = create_sequential_roller [ 1i32; 2; 3; 4 ]\n\narraym.init 50i32 (ignore >> sequential_roll)\n|> _assert_eq (;[ 1; 2; 3; 4; 4; 3; 2; 1; 2; 3; 4; 4; 3; 2; 1; 3; 4; 4; 3; 2; 1; 4; 4; 3; 2; 1;\n4; 3; 2; 1; 3; 2; 1; 2; 1; 1; 1; 2; 3; 4; 4; 3; 2; 1; 2; 3; 4; 4; 3; 2 ] : array i32)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test
  ///> rust
  ///> fsharp
  ///> typescript

  := sequential_roll = create_sequential_roller [ 1i32; 2; 3; 4 ]

  arraym.init 50i32 (ignore >> sequential_roll)
  |> _assert_eq (;[ 1; 2; 3; 4; 4; 3; 2; 1; 2; 3; 4; 4; 3; 2; 1; 3; 4; 4; 3; 2; 1; 4; 4; 3; 2; 1;
  4; 3; 2; 1; 3; 2; 1; 2; 1; 1; 1; 2; 3; 4; 4; 3; 2; 1; 2; 3; 4; 4; 3; 2 ] : array i32)
  """,
  timeout: 300_000
)
```

## roll_progressively

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= roll_progressively (roll : () -> u8) (reroll : bool) max =\n    roll_value (? reroll ?> Fresh |: Slide) max (roller roll)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := roll_progressively (roll : () -> u8) (reroll : bool) max =
      roll_value (? reroll ?> Fresh |: Slide) max (roller roll)
  """,
  timeout: 300_000
)
