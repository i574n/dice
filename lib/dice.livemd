<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl main (_args : array_base string) =\n    inl result = roll_progressively roll_dice true 4738381338321616896i64\n    trace Debug\n        fun () => \"dice.main\"\n        fun () => { result }\n    0i32\n\ninl main () =\n    inl rotate_numbers' : i64 -> stream.stream u8 -> stream.stream u8 =\n        rotate_numbers\n\n    inl create_sequential_roller' :\n        list u8\n        -> (() -> u8)\n        =\n        create_sequential_roller\n\n    inl roll_progressively' :\n        (() -> u8)\n        -> bool\n        -> u64\n        -> u64\n        =\n        roll_progressively\n\n    inl roll_within_bounds' :\n        u64\n        -> list u8\n        -> optionm'.option' u64\n        =\n        fun a b =>\n            roll_within_bounds a b\n            |> optionm'.box\n\n    backend_switch {\n        Fsharp = fun () => $'let rotate_numbers x = !rotate_numbers' x' : ()\n        Rust = fun () => ()\n        TypeScript = fun () => ()\n    } : ()\n    backend_switch {\n        Fsharp = fun () => $'let create_sequential_roller x = !create_sequential_roller' x' : ()\n        Rust = fun () => ()\n        TypeScript = fun () => ()\n    } : ()\n    backend_switch {\n        Fsharp = fun () => $'let roll_progressively x = !roll_progressively' x' : ()\n        Rust = fun () => ()\n        TypeScript = fun () => ()\n    } : ()\n    backend_switch {\n        Fsharp = fun () => $'let roll_within_bounds x = !roll_within_bounds' x' : ()\n        Rust = fun () => ()\n        TypeScript = fun () => ()\n    } : ()\n    backend_switch {\n        Fsharp = fun () => $'let main args = !main args' : ()\n        Rust = fun () => main ;[] |> ignore\n        Python = fun () => main ;[] |> ignore\n        TypeScript = fun () => main ;[] |> ignore\n    } : ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl main (_args : array_base string) =
      inl result = roll_progressively roll_dice true 4738381338321616896i64
      trace Debug
          fun () => "dice.main"
          fun () => { result }
      0i32

  inl main () =
      inl rotate_numbers' : i64 -> stream.stream u8 -> stream.stream u8 =
          rotate_numbers

      inl create_sequential_roller' :
          list u8
          -> (() -> u8)
          =
          create_sequential_roller

      inl roll_progressively' :
          (() -> u8)
          -> bool
          -> u64
          -> u64
          =
          roll_progressively

      inl roll_within_bounds' :
          u64
          -> list u8
          -> optionm'.option' u64
          =
          fun a b =>
              roll_within_bounds a b
              |> optionm'.box

      backend_switch {
          Fsharp = fun () => $'let rotate_numbers x = !rotate_numbers' x' : ()
          Rust = fun () => ()
          TypeScript = fun () => ()
      } : ()
      backend_switch {
          Fsharp = fun () => $'let create_sequential_roller x = !create_sequential_roller' x' : ()
          Rust = fun () => ()
          TypeScript = fun () => ()
      } : ()
      backend_switch {
          Fsharp = fun () => $'let roll_progressively x = !roll_progressively' x' : ()
          Rust = fun () => ()
          TypeScript = fun () => ()
      } : ()
      backend_switch {
          Fsharp = fun () => $'let roll_within_bounds x = !roll_within_bounds' x' : ()
          Rust = fun () => ()
          TypeScript = fun () => ()
      } : ()
      backend_switch {
          Fsharp = fun () => $'let main args = !main args' : ()
          Rust = fun () => main ;[] |> ignore
          Python = fun () => main ;[] |> ignore
          TypeScript = fun () => main ;[] |> ignore
      } : ()
  """,
  timeout: 300_000
)
```
