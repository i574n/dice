```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test

  inl histogram (reroll : bool) : i32 =
      inl { level } = get_trace_state_or_init None
      level <- Info
      let rec insert (row : i32 * i32) (rows : list (i32 * i32)) : list (i32 * i32) =
          match rows with
          | [] => [ row ]
          | (k2, v2) :: rest =>
              inl k, v = row
              if k <= k2 then (k, v) :: (k2, v2) :: rest
              else (k2, v2) :: insert row rest
      join dyn listm'.init_series 1i32 10000 1
      |> listm.map (fun _ => roll_progressively roll_dice reroll 10i32)
      |> listm'.group_by id
      |> listm.map (fun (k, v) => k, (listm.length v : i32))
      |> listm.fold (fun acc row => insert row acc) []
      |> listm.fold (fun acc (k, v) => if acc = "" then #?k ++# " = " ++# #?v else acc ++# "; " ++# #?k ++# " = " ++# #?v) ""
      |> console.write_line
      0i32

  histogram true
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n\ninl check_progress () : i32 =\n    inl { level } = get_trace_state_or_init None\n    level <- Info\n    join dyn listm'.init_series 1i32 100 1\n    |> listm.iter fun n =>\n        listm'.init_series 0i32 1 1\n        |> listm.iter fun reroll =>\n            join dyn listm'.init_series 1i32 3500 1\n            |> listm.map fun _ => roll_progressively roll_dice (reroll = 1) n\n            |> listm'.group_by id\n            |> listm.length\n            |> __assert_eq Silent n\n    0i32\n\ncheck_progress ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test

  inl check_progress () : i32 =
      inl { level } = get_trace_state_or_init None
      level <- Info
      join dyn listm'.init_series 1i32 100 1
      |> listm.iter fun n =>
          listm'.init_series 0i32 1 1
          |> listm.iter fun reroll =>
              join dyn listm'.init_series 1i32 3500 1
              |> listm.map fun _ => roll_progressively roll_dice (reroll = 1) n
              |> listm'.group_by id
              |> listm.length
              |> __assert_eq Silent n
      0i32

  check_progress ()
  """,
  timeout: 300_000
)
```

