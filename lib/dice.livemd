  |> _assert_eq (a ;[ 1; 2; 3; 4; 4; 3; 2; 1; 2; 3; 4; 4; 3; 2; 1; 3; 4; 4; 3; 2; 1; 4; 4; 3; 2; 1;
  4; 3; 2; 1; 3; 2; 1; 2; 1; 1; 1; 2; 3; 4; 4; 3; 2; 1; 2; 3; 4; 4; 3; 2 ] : a i32 i32)
  """,
  timeout: 300_000
)
```

## roll_progressively

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl roll_progressively roll reroll max =\n    inl power = (calculate_dice_count max) - 1\n    let rec 루프 rolls size =\n        if size < power + 1\n        then 루프 (roll () :: rolls) (size + 1)\n        else accumulate_dice_rolls rolls power 0 |> function\n            | Some (result, _) when result <= max => result\n            | _ when reroll => 루프 (listm.init power (fun _ => roll ())) power\n            | _ => 루프 (roll () :: rolls) (size + 1)\n    루프 [] 0","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl roll_progressively roll reroll max =
      inl power = (calculate_dice_count max) - 1
      let rec 루프 rolls size =
          if size < power + 1
          then 루프 (roll () :: rolls) (size + 1)
          else accumulate_dice_rolls rolls power 0 |> function
              | Some (result, _) when result <= max => result
              | _ when reroll => 루프 (listm.init power (fun _ => roll ())) power
              | _ => 루프 (roll () :: rolls) (size + 1)
      루프 [] 0
  """,
  timeout: 300_000
)
```

