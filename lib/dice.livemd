## accumulate_dice_rolls

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl accumulate_dice_rolls\n    (rolls : list u8)\n    (power : i8)\n    acc\n    =\n    inl rec body forall a {number} b {number} c {number}.\n        (acc : a)\n        (power : b)\n        (rolls : list c)\n        : option (a * list c)\n        =\n        match rolls with\n        | _ when power < 0 =>\n            inl result = acc + 1\n            trace Debug\n                fun () => \"dice.accumulate_dice_rolls\"\n                fun () => { power acc result }\n            Some (result, rolls)\n        | [] => None\n        | roll :: rest when roll > 1 =>\n            inl coeff = sixth_power_sequence () |> stream.item power\n            inl value = conv (roll - 1) * coeff\n            trace Debug\n                fun () => \"dice.accumulate_dice_rolls\"\n                fun () => { power acc roll value }\n            루프 (acc + value) (power - 1) rest\n        | roll :: rest =>\n            trace Debug\n                fun () => \"dice.accumulate_dice_rolls\"\n                fun () => { power acc roll }\n            루프 acc (power - 1) rest\n    and inl 루프 forall a {number} b {number} c {number}.\n        (acc : a)\n        (power : b)\n        (rolls : list c)\n        : option (a * list c)\n        =\n        if var_is rolls |> not\n        then body acc power rolls\n        else\n            inl acc = dyn acc\n            join body acc power rolls\n    루프 acc power rolls","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl accumulate_dice_rolls
      (rolls : list u8)
      (power : i8)
      acc
      =
      inl rec body forall a {number} b {number} c {number}.
          (acc : a)
          (power : b)
          (rolls : list c)
          : option (a * list c)
          =
          match rolls with
          | _ when power < 0 =>
              inl result = acc + 1
              trace Debug
                  fun () => "dice.accumulate_dice_rolls"
                  fun () => { power acc result }
              Some (result, rolls)
          | [] => None
          | roll :: rest when roll > 1 =>
              inl coeff = sixth_power_sequence () |> stream.item power
              inl value = conv (roll - 1) * coeff
              trace Debug
                  fun () => "dice.accumulate_dice_rolls"
                  fun () => { power acc roll value }
              루프 (acc + value) (power - 1) rest
          | roll :: rest =>
              trace Debug
                  fun () => "dice.accumulate_dice_rolls"
                  fun () => { power acc roll }
              루프 acc (power - 1) rest
      and inl 루프 forall a {number} b {number} c {number}.
          (acc : a)
          (power : b)
          (rolls : list c)
          : option (a * list c)
          =
          if var_is rolls |> not
          then body acc power rolls
          else
              inl acc = dyn acc
              join body acc power rolls
      루프 acc power rolls
  """,
  timeout: 300_000
)
```

