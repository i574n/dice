## create_sequential_roller

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl create_sequential_roller list =\n    inl s = list |> listm.rev |> listm.append list |> stream.from_list |> stream.memoize\n    inl current_index = mut 0i64\n    inl acc = mut 1\n    inl len = mut -1\n    inl last_item = mut None\n    let rec 루프 () =\n        fun () =>\n            inl current_index = *current_index\n            inl acc = *acc\n            inl len = *len\n            inl last_item = *last_item |> optionm'.box\n            trace Debug\n                fun () => \"dice.create_sequential_roller / roll\"\n                fun () => { current_index acc len last_item = #?*last_item }\n        |> fun x => x ()\n        match s () |> stream.try_item *current_index with\n        | Some item =>\n            current_index <- *current_index + 1\n            last_item <- Some item\n            item\n        | None =>\n            trace Debug (fun () => \"dice.create_sequential_roller / roll / None\") id\n            if *len = -1\n            then len <- *current_index\n            acc <-\n                if *acc >= *len\n                then 1\n                else *acc + 1\n            current_index <- *acc - 1\n            last_item <- None\n            루프 ()\n    루프","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl create_sequential_roller list =
      inl s = list |> listm.rev |> listm.append list |> stream.from_list |> stream.memoize
      inl current_index = mut 0i64
      inl acc = mut 1
      inl len = mut -1
      inl last_item = mut None
      let rec 루프 () =
          fun () =>
              inl current_index = *current_index
              inl acc = *acc
              inl len = *len
              inl last_item = *last_item |> optionm'.box
              trace Debug
                  fun () => "dice.create_sequential_roller / roll"
                  fun () => { current_index acc len last_item = #?*last_item }
          |> fun x => x ()
          match s () |> stream.try_item *current_index with
          | Some item =>
              current_index <- *current_index + 1
              last_item <- Some item
              item
          | None =>
              trace Debug (fun () => "dice.create_sequential_roller / roll / None") id
              if *len = -1
              then len <- *current_index
              acc <-
                  if *acc >= *len
                  then 1
                  else *acc + 1
              current_index <- *acc - 1
              last_item <- None
              루프 ()
      루프
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n\ninl sequential_roll = create_sequential_roller [ 1i32; 2; 3; 4 ]\n\nam.init 50i32 (ignore >> sequential_roll)\n|> _assert_eq (a ;[ 1; 2; 3; 4; 4; 3; 2; 1; 2; 3; 4; 4; 3; 2; 1; 3; 4; 4; 3; 2; 1; 4; 4; 3; 2; 1;\n4; 3; 2; 1; 3; 2; 1; 2; 1; 1; 1; 2; 3; 4; 4; 3; 2; 1; 2; 3; 4; 4; 3; 2 ] : a i32 i32)","print_code":false},"livebook_object":"smart_cell"} -->

