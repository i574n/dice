## phases

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":! requested = ()\n\n:! bounded = ()\n\n:! gathered = ()\n\n:! hashed = ()\n\n:! rolled = ()\n\n:| roll_state phase =\n    | Requested :: u64 * call -> roll_state requested\n    | Bounded :: lib.dice.bound u64 * call -> roll_state bounded\n    | Gathered :: lib.dice.bound u64 * entropy -> roll_state gathered\n    | Hashed :: lib.dice.bound u64 * entropy * array u8 -> roll_state hashed\n    | Rolled :: u64 * entropy * array u8 -> roll_state rolled\n\n:| roll_step from to =\n    | CheckBound :: roll_step requested bounded\n    | Gather :: roll_step bounded gathered\n    | Hash :: roll_step gathered hashed\n    | Draw :: roll_step hashed rolled\n\n:| ^ roll_plan from to =\n    | Step :: \\* from to. roll_step from to -> roll_plan from to\n    | Then :: \\* from to. (\\? middle. roll_plan from middle * roll_plan middle to) -> roll_plan from to\n\n:= check_bound \\* c {fail_with}. (chain : c) (state : roll_state requested) : roll_state bounded =\n    ?= state ?|\n    | Requested (max, call) =>\n        := b =\n            ?= lib.dice.bound_of max ?|\n            | Ok b => b\n            | Error e => fail_with chain (\"dice_contract.generate_random_number / \" ++# lib.dice.bound_error_text e)\n        Bounded (b, call)\n\n:= gather \\* c {read_entropy}. (chain : c) (state : roll_state bounded) : roll_state gathered =\n    ?= state ?|\n    | Bounded (b, call) => Gathered (b, read_entropy chain call)\n\n:= hash \\* c {digest_with}. (chain : c) (state : roll_state gathered) : roll_state hashed =\n    ?= state ?|\n    | Gathered (b, e) => Hashed (b, e, digest_with chain (entropy_bytes e))\n\n:= draw \\* c {digest_with}. (chain : c) (state : roll_state hashed) : roll_state rolled =\n    ?= state ?|\n    | Hashed (b, e, digest) =>\n        := value, _ = lib.dice.roll lib.dice.Recycle b (lib.dice.hashed chain digest)\n        Rolled (value, e, digest)\n\n:= run_step \\* from to c {read_entropy; fail_with; digest_with}.\n    (chain : c)\n    (step : roll_step from to)\n    (state : roll_state from)\n    : roll_state to\n    =\n    ?= step ?|\n    | CheckBound => check_bound chain state\n    | Gather => gather chain state\n    | Hash => hash chain state\n    | Draw => draw chain state\n\n:= ^ run \\* from to c {read_entropy; fail_with; digest_with}.\n    (chain : c)\n    (plan : roll_plan from to)\n    (state : roll_state from)\n    : roll_state to\n    =\n    ?= plan ?|\n    | Step step => run_step chain step state\n    | Then pair =>\n        := \\? middle. first, second = pair\n        run chain second (run chain first state)\n\n:= generate_plan () : roll_plan requested rolled =\n    Then (\\? (Step CheckBound, Then (\\? (Step Gather, Then (\\? (Step Hash, Step Draw))))))\n\n:= generate \\* c {read_entropy; fail_with; digest_with}. (chain : c) (call : call) (max : u64) : roll_state rolled =\n    run chain (generate_plan ()) (Requested (max, call))\n\n:= rolled_value (state : roll_state rolled) : u64 =\n    ?= state ?|\n    | Rolled (value, _, _) => value","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :! requested = ()

  :! bounded = ()

  :! gathered = ()

  :! hashed = ()

  :! rolled = ()

  :| roll_state phase =
      | Requested :: u64 * call -> roll_state requested
      | Bounded :: lib.dice.bound u64 * call -> roll_state bounded
      | Gathered :: lib.dice.bound u64 * entropy -> roll_state gathered
      | Hashed :: lib.dice.bound u64 * entropy * array u8 -> roll_state hashed
      | Rolled :: u64 * entropy * array u8 -> roll_state rolled

  :| roll_step from to =
      | CheckBound :: roll_step requested bounded
      | Gather :: roll_step bounded gathered
      | Hash :: roll_step gathered hashed
      | Draw :: roll_step hashed rolled

  :| ^ roll_plan from to =
      | Step :: \* from to. roll_step from to -> roll_plan from to
      | Then :: \* from to. (\? middle. roll_plan from middle * roll_plan middle to) -> roll_plan from to

  := check_bound \* c {fail_with}. (chain : c) (state : roll_state requested) : roll_state bounded =
      ?= state ?|
      | Requested (max, call) =>
          := b =
              ?= lib.dice.bound_of max ?|
              | Ok b => b
              | Error e => fail_with chain ("dice_contract.generate_random_number / " ++# lib.dice.bound_error_text e)
          Bounded (b, call)

  := gather \* c {read_entropy}. (chain : c) (state : roll_state bounded) : roll_state gathered =
      ?= state ?|
      | Bounded (b, call) => Gathered (b, read_entropy chain call)

  := hash \* c {digest_with}. (chain : c) (state : roll_state gathered) : roll_state hashed =
      ?= state ?|
      | Gathered (b, e) => Hashed (b, e, digest_with chain (entropy_bytes e))

  := draw \* c {digest_with}. (chain : c) (state : roll_state hashed) : roll_state rolled =
      ?= state ?|
      | Hashed (b, e, digest) =>
          := value, _ = lib.dice.roll lib.dice.Recycle b (lib.dice.hashed chain digest)
          Rolled (value, e, digest)

  := run_step \* from to c {read_entropy; fail_with; digest_with}.
      (chain : c)
      (step : roll_step from to)
      (state : roll_state from)
      : roll_state to
      =
      ?= step ?|
      | CheckBound => check_bound chain state
      | Gather => gather chain state
      | Hash => hash chain state
      | Draw => draw chain state

  := ^ run \* from to c {read_entropy; fail_with; digest_with}.
      (chain : c)
      (plan : roll_plan from to)
      (state : roll_state from)
      : roll_state to
      =
      ?= plan ?|
      | Step step => run_step chain step state
      | Then pair =>
          := \? middle. first, second = pair
          run chain second (run chain first state)

  := generate_plan () : roll_plan requested rolled =
      Then (\? (Step CheckBound, Then (\? (Step Gather, Then (\? (Step Hash, Step Draw))))))

  := generate \* c {read_entropy; fail_with; digest_with}. (chain : c) (call : call) (max : u64) : roll_state rolled =
      run chain (generate_plan ()) (Requested (max, call))

  := rolled_value (state : roll_state rolled) : u64 =
      ?= state ?|
      | Rolled (value, _, _) => value
  """,
  timeout: 300_000
)
```

