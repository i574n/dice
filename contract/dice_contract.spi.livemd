#### the_host_reads_the_chain_the_fixture_describes (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> rust -d \"near-sdk={version='=5.30.1',features=['unit-testing']}\" -d near-token\n\nmocked_chain ()\n:= host_entropy = read_entropy host (sample_call \"k\")\n:= fixture_entropy = read_entropy (sample_fixture ()) (sample_call \"k\")\n(entropy_text host_entropy = entropy_text fixture_entropy, entropy_bytes host_entropy |> bytes.hex = (entropy_bytes fixture_entropy |> bytes.hex))\n|> _assert_eq (!+, !+)","print_code":false},"livebook_object":"smart_cell"} -->

