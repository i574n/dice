## entropy

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":== entropy =\n    {\n        account_balance_high : u64\n        account_balance_low : u64\n        block_height : u64\n        block_timestamp : u64\n        epoch_height : u64\n        key : string\n        predecessor : string\n        proof : string\n        seed : array u8\n        seeds : array u8\n        signer : string\n    }\n\n:== call =\n    {\n        key : string\n        proof : string\n        seeds : array u8\n    }\n\n:= u64_text (x : u64) : string =\n    #?x\n\n:= part_bytes \\* t. (x : t) : array u8 =\n    ~>\n        ?: t ?|\n        | u64 => bytes.le_u64 x\n        | string => bytes.utf8 x\n        | array u8 => x\n\n:= part_text \\* t. (x : t) : string =\n    ~>\n        ?: t ?|\n        | u64 => u64_text x\n        | string => x\n        | array u8 => bytes.hex x\n\n:= entropy_bytes (e : entropy) : array u8 =\n    bytes.concat (\n        ~>\n            real_core::record_type_fold_back\n                (\\ key => \\* field. acc => (::) `(array u8) (part_bytes `field (e key)) acc)\n                `entropy\n                (Nil `(array u8))\n    )\n\n:= entropy_text (e : entropy) : string =\n    ~>\n        real_core::record_type_fold_back\n            (\\ key => \\* field. acc =>\n                (::) `(string * string) (sm'_real::symbol_to_string_real `(`key), part_text `field (e key)) acc\n            )\n            `entropy\n            (Nil `(string * string))\n    |> listm.fold (\\ (first, acc) (name, value) => !-, acc ++# (? first ?> \"\" |: \"; \") ++# name ++# \" = \" ++# value) (!+, \"\")\n    |> snd","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :== entropy =
      {
          account_balance_high : u64
          account_balance_low : u64
          block_height : u64
          block_timestamp : u64
          epoch_height : u64
          key : string
          predecessor : string
          proof : string
          seed : array u8
          seeds : array u8
          signer : string
      }

  :== call =
      {
          key : string
          proof : string
          seeds : array u8
      }

  := u64_text (x : u64) : string =
      #?x

  := part_bytes \* t. (x : t) : array u8 =
      ~>
          ?: t ?|
          | u64 => bytes.le_u64 x
          | string => bytes.utf8 x
          | array u8 => x

  := part_text \* t. (x : t) : string =
      ~>
          ?: t ?|
          | u64 => u64_text x
          | string => x
          | array u8 => bytes.hex x

  := entropy_bytes (e : entropy) : array u8 =
      bytes.concat (
          ~>
              real_core::record_type_fold_back
                  (\ key => \* field. acc => (::) `(array u8) (part_bytes `field (e key)) acc)
                  `entropy
                  (Nil `(array u8))
      )

  := entropy_text (e : entropy) : string =
      ~>
          real_core::record_type_fold_back
              (\ key => \* field. acc =>
                  (::) `(string * string) (sm'_real::symbol_to_string_real `(`key), part_text `field (e key)) acc
              )
              `entropy
              (Nil `(string * string))
      |> listm.fold (\ (first, acc) (name, value) => !-, acc ++# (? first ?> "" |: "; ") ++# name ++# " = " ++# value) (!+, "")
      |> snd
  """,
  timeout: 300_000
)
```

## chain

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":? read_entropy c : c -> call -> entropy\n\n:? fail_with c : \\* t. c -> string -> t\n\n:! host = ()\n\n:+ read_entropy host =\n    \\ _ (call : call) =>\n        := low, high = near.host_account_balance_words ()\n        {\n            account_balance_high = high\n            account_balance_low = low\n            block_height = near.host_block_height ()\n            block_timestamp = near.host_block_timestamp ()\n            epoch_height = near.host_epoch_height ()\n            key = call.key\n            predecessor = near.host_predecessor ()\n            proof = call.proof\n            seed = near.host_random_seed ()\n            seeds = call.seeds\n            signer = near.host_signer ()\n        }\n\n:+ fail_with host =\n    \\ _ text => near.panic text\n\n:+ digest_with host =\n    \\ _ digest => near.host_keccak512 digest\n\n:! fixture =\n    {\n        account_balance : u64 * u64\n        block_height : u64\n        block_timestamp : u64\n        epoch_height : u64\n        predecessor : string\n        seed : array u8\n        signer : string\n    }\n\n:+ read_entropy fixture =\n    \\ (fixture f) (call : call) =>\n        := low, high = f.account_balance\n        {\n            account_balance_high = high\n            account_balance_low = low\n            block_height = f.block_height\n            block_timestamp = f.block_timestamp\n            epoch_height = f.epoch_height\n            key = call.key\n            predecessor = f.predecessor\n            proof = call.proof\n            seed = f.seed\n            seeds = call.seeds\n            signer = f.signer\n        }\n\n:+ fail_with fixture =\n    \\ _ text => failwith text\n\n:+ digest_with fixture =\n    \\ _ digest => keccak.keccak512 digest |> keccak.digest_bytes\n\n:= sample_fixture () : fixture =\n    fixture {\n        account_balance = (7u64, 1u64)\n        block_height = 42u64\n        block_timestamp = 1700000000000000000u64\n        epoch_height = 3u64\n        predecessor = \"alice.near\"\n        seed = bytes.repeated 32i32 7u8\n        signer = \"alice.near\"\n    }\n\n:= sample_call (key : string) : call =\n    { key = key; proof = \"\"; seeds = bytes.counting 4i32 }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :? read_entropy c : c -> call -> entropy

  :? fail_with c : \* t. c -> string -> t

  :! host = ()

  :+ read_entropy host =
      \ _ (call : call) =>
          := low, high = near.host_account_balance_words ()
          {
              account_balance_high = high
              account_balance_low = low
              block_height = near.host_block_height ()
              block_timestamp = near.host_block_timestamp ()
              epoch_height = near.host_epoch_height ()
              key = call.key
              predecessor = near.host_predecessor ()
              proof = call.proof
              seed = near.host_random_seed ()
              seeds = call.seeds
              signer = near.host_signer ()
          }

  :+ fail_with host =
      \ _ text => near.panic text

  :+ digest_with host =
      \ _ digest => near.host_keccak512 digest

  :! fixture =
      {
          account_balance : u64 * u64
          block_height : u64
          block_timestamp : u64
          epoch_height : u64
          predecessor : string
          seed : array u8
          signer : string
      }

  :+ read_entropy fixture =
      \ (fixture f) (call : call) =>
          := low, high = f.account_balance
          {
              account_balance_high = high
              account_balance_low = low
              block_height = f.block_height
              block_timestamp = f.block_timestamp
              epoch_height = f.epoch_height
              key = call.key
              predecessor = f.predecessor
              proof = call.proof
              seed = f.seed
              seeds = call.seeds
              signer = f.signer
          }

  :+ fail_with fixture =
      \ _ text => failwith text

  :+ digest_with fixture =
      \ _ digest => keccak.keccak512 digest |> keccak.digest_bytes

  := sample_fixture () : fixture =
      fixture {
          account_balance = (7u64, 1u64)
          block_height = 42u64
          block_timestamp = 1700000000000000000u64
          epoch_height = 3u64
          predecessor = "alice.near"
          seed = bytes.repeated 32i32 7u8
          signer = "alice.near"
      }

  := sample_call (key : string) : call =
      { key = key; proof = ""; seeds = bytes.counting 4i32 }
  """,
  timeout: 300_000
)
```

#### entropy_bytes_follow_the_field_order_of_the_record (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> rust\n///> fsharp\n///> typescript\n///> python\n///> lua\n///> c\n///> zig\n///> gleam\n///> pascal\n\n:= ~key = \"k\"\nread_entropy (sample_fixture ()) (sample_call key)\n|> entropy_bytes\n|> keccak.keccak512\n|> keccak.digest_bytes\n|> bytes.hex\n|> sm'.slice 0i32 15i32\n|> _assert_eq \"0e10e94fc9dfb460\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test
  ///> rust
  ///> fsharp
  ///> typescript
  ///> python
  ///> lua
  ///> c
  ///> zig
  ///> gleam
  ///> pascal

  := ~key = "k"
  read_entropy (sample_fixture ()) (sample_call key)
  |> entropy_bytes
  |> keccak.keccak512
  |> keccak.digest_bytes
  |> bytes.hex
  |> sm'.slice 0i32 15i32
  |> _assert_eq "0e10e94fc9dfb460"
