#### generate_random_number_appends_the_hash_to_the_seeds (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> rust -d \"near-sdk={version='=5.30.1',features=['unit-testing']}\" -d near-token\n\nmocked_chain ()\n:= seeds = ([] : list u8) |> am'.new_vec |> rust.to_ref_mut\n:= key = \"k\" |> sm'.to_std_string\n:= proof = \"\" |> sm'.to_std_string\n:= first = generate_random_number seeds key proof 2000u64\n:= after_first : u64 = seeds |> am'.vec_ref_len |> convert.convert\n:= second = generate_random_number seeds key proof 2000u64\n:= after_second : u64 = seeds |> am'.vec_ref_len |> convert.convert\n(first, after_first, second, after_second)\n|> _assert_eq (762u64, 64u64, 1614u64, 100u64)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test
  ///> rust -d "near-sdk={version='=5.30.1',features=['unit-testing']}" -d near-token

  mocked_chain ()
  := seeds = ([] : list u8) |> am'.new_vec |> rust.to_ref_mut
  := key = "k" |> sm'.to_std_string
  := proof = "" |> sm'.to_std_string
  := first = generate_random_number seeds key proof 2000u64
  := after_first : u64 = seeds |> am'.vec_ref_len |> convert.convert
  := second = generate_random_number seeds key proof 2000u64
  := after_second : u64 = seeds |> am'.vec_ref_len |> convert.convert
  (first, after_first, second, after_second)
  |> _assert_eq (762u64, 64u64, 1614u64, 100u64)
  """,
  timeout: 300_000
)
```

#### the_host_glue_pins_its_gas (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> rust -d \"near-sdk={version='=5.30.1',features=['unit-testing']}\" -d near-token\n\nmocked_chain ()\n:= used () : u64 = $'near_sdk::env::used_gas().as_gas()' : u64\n:= start = used ()\n:= seed = near.host_random_seed ()\n:= after_seed = used ()\n:= digest = near.host_keccak512 (bytes.counting 150i32)\n:= after_hash = used ()\n:= state = generate host (sample_call \"k\") 2000u64\n:= after_roll = used ()\n(after_seed - start, after_hash - after_seed, after_roll - after_hash, length seed + length digest, rolled_value state)\n|> _assert_eq (9192751602u64, 23628854763u64, 52413432801u64, 96i32, 1646u64)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test
  ///> rust -d "near-sdk={version='=5.30.1',features=['unit-testing']}" -d near-token

  mocked_chain ()
  := used () : u64 = $'near_sdk::env::used_gas().as_gas()' : u64
  := start = used ()
  := seed = near.host_random_seed ()
  := after_seed = used ()
  := digest = near.host_keccak512 (bytes.counting 150i32)
  := after_hash = used ()
  := state = generate host (sample_call "k") 2000u64
  := after_roll = used ()
  (after_seed - start, after_hash - after_seed, after_roll - after_hash, length seed + length digest, rolled_value state)
  |> _assert_eq (9192751602u64, 23628854763u64, 52413432801u64, 96i32, 1646u64)
  """,
  timeout: 300_000
)
```

### main

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= quiet () : () =\n    set_trace_level Debug\n\n:= state_struct () : () =\n    global \"\"\"\n        #[near_sdk::near(contract_state)]\n        #[derive(near_sdk::PanicOnDefault)]\n        pub struct State((u32, Vec<u8>));\n        \"\"\"\n\n:= legacy_state () : () =\n    global \"\"\"\n        #[derive(near_sdk::PanicOnDefault, borsh::BorshDeserialize, borsh::BorshSerialize)]\n        pub struct OldState {\n            version: u32,\n            seeds: near_sdk::store::vec::Vector<u8>,\n        }\n        \"\"\"\n    global \"\"\"\n        impl From<OldState> for State {\n            fn from(mut old_state: OldState) -> Self {\n                let seeds = old_state.seeds.iter().copied().collect();\n                old_state.seeds.clear();\n                old_state.seeds.flush();\n                Self((old_state.version + 1, seeds))\n            }\n        }\n        \"\"\"\n\n:= init_methods () : () =\n    global \"\"\"\n        #[near_sdk::near]\n        impl State {\n            #[init]\n            pub fn new() -> Self {\n                Self(dice_contract_new())\n            }\n            #[private]\n            #[init(ignore_state)]\n            pub fn migrate() -> Self {\n                let raw = near_sdk::env::storage_read(b\"STATE\")\n                    .unwrap_or_else(|| near_sdk::env::panic_str(\"dice_contract.migrate / no state to migrate\"));\n                if raw.len() >= 4 && u32::from_le_bytes([raw[0], raw[1], raw[2], raw[3]]) >= 3 {\n                    near_sdk::env::panic_str(\"dice_contract.migrate / the state is already migrated\")\n                }\n                borsh::from_slice::<OldState>(&raw)\n                    .unwrap_or_else(|_| near_sdk::env::panic_str(\"dice_contract.migrate / the state is not the old layout\"))\n                    .into()\n            }\n        }\n        \"\"\"\n    export\n        \"dice_contract_new\"\n        ((\\ () => := () = quiet () ;; new ()) : () -> u32 * am'.vec u8)\n\n:= seed_methods () : () =\n    global \"\"\"\n        #[near_sdk::near]\n        impl State {\n            pub fn contribute_seed(&mut self, seed: Vec<u8>) {\n                dice_contract_contribute_seed(&mut self.0.1, seed)\n            }\n            pub fn contribute_seed_borsh(&mut self, #[serializer(borsh)] seed: Vec<u8>) {\n                self.contribute_seed(seed)\n            }\n        }\n        \"\"\"\n    export\n        \"dice_contract_contribute_seed\"\n        (\n            \\ (seeds, seed) =>\n                := () = quiet ()\n                contribute_seed seeds seed\n            : rust.ref (rust.mut' (am'.vec u8)) * am'.vec u8 -> ()\n        )\n\n:= roll_methods () : () =\n    global \"\"\"\n        #[near_sdk::near]\n        impl State {\n            pub fn generate_random_number(&mut self, key: String, proof: String, max: u64) -> u64 {\n                dice_contract_generate_random_number(&mut self.0.1, key, proof, max)\n            }\n        }\n        \"\"\"\n    export\n        \"dice_contract_generate_random_number\"\n        (\n            \\ (seeds, key, proof, max) =>\n                := () = quiet ()\n                generate_random_number seeds key proof max\n            : rust.ref (rust.mut' (am'.vec u8)) * sm'.std_string * sm'.std_string * u64 -> u64\n        )\n\n:= bound_methods () : () =\n    global \"\"\"\n        #[near_sdk::near]\n        impl State {\n            pub fn roll_within_bounds(max: u64, rolls: Vec<u8>) -> Option<u64> {\n                dice_contract_roll_within_bounds(max, rolls)\n            }\n            #[result_serializer(borsh)]\n            pub fn roll_within_bounds_borsh(\n                #[serializer(borsh)] max: u64,\n                #[serializer(borsh)] rolls: Vec<u8>,\n            ) -> Option<u64> {\n                Self::roll_within_bounds(max, rolls)\n            }\n        }\n        \"\"\"\n    export\n        \"dice_contract_roll_within_bounds\"\n        (\n            \\ (max, rolls) =>\n                := () = quiet ()\n                roll_within_bounds max rolls\n            : u64 * am'.vec u8 -> optionm'.option' u64\n        )\n\n:= main_native () : () =\n    near.bump_allocator ()\n    state_struct ()\n    legacy_state ()\n    init_methods ()\n    seed_methods ()\n    roll_methods ()\n    bound_methods ()\n\n:= main () =\n    ? is_rust ()\n    ?> main_native ()\n    |: ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ":= quiet () : () =\n    set_trace_level Debug\n\n:= state_struct () : () =\n    global \"\"\"\n        #[near_sdk::near(contract_state)]\n        #[derive(near_sdk::PanicOnDefault)]\n        pub struct State((u32, Vec<u8>));\n        \"\"\"\n\n:= legacy_state () : () =\n    global \"\"\"\n        #[derive(near_sdk::PanicOnDefault, borsh::BorshDeserialize, borsh::BorshSerialize)]\n        pub struct OldState {\n            version: u32,\n            seeds: near_sdk::store::vec::Vector<u8>,\n        }\n        \"\"\"\n    global \"\"\"\n        impl From<OldState> for State {\n            fn from(mut old_state: OldState) -> Self {\n                let seeds = old_state.seeds.iter().copied().collect();\n                old_state.seeds.clear();\n                old_state.seeds.flush();\n                Self((old_state.version + 1, seeds))\n            }\n        }\n        \"\"\"\n\n:= init_methods () : () =\n    global \"\"\"\n        #[near_sdk::near]\n        impl State {\n            #[init]\n            pub fn new() -> Self {\n                Self(dice_contract_new())\n            }\n            #[private]\n            #[init(ignore_state)]\n            pub fn migrate() -> Self {\n                let raw = near_sdk::env::storage_read(b\"STATE\")\n                    .unwrap_or_else(|| near_sdk::env::panic_str(\"dice_contract.migrate / no state to migrate\"));\n                if raw.len() >= 4 && u32::from_le_bytes([raw[0], raw[1], raw[2], raw[3]]) >= 3 {\n                    near_sdk::env::panic_str(\"dice_contract.migrate / the state is already migrated\")\n                }\n                borsh::from_slice::<OldState>(&raw)\n                    .unwrap_or_else(|_| near_sdk::env::panic_str(\"dice_contract.migrate / the state is not the old layout\"))\n                    .into()\n            }\n        }\n        \"\"\"\n    export\n        \"dice_contract_new\"\n        ((\\ () => := () = quiet () ;; new ()) : () -> u32 * am'.vec u8)\n\n:= seed_methods () : () =\n    global \"\"\"\n        #[near_sdk::near]\n        impl State {\n            pub fn contribute_seed(&mut self, seed: Vec<u8>) {\n                dice_contract_contribute_seed(&mut self.0.1, seed)\n            }\n            pub fn contribute_seed_borsh(&mut self, #[serializer(borsh)] seed: Vec<u8>) {\n                self.contribute_seed(seed)\n            }\n        }\n        \"\"\"\n    export\n        \"dice_contract_contribute_seed\"\n        (\n            \\ (seeds, seed) =>\n                := () = quiet ()\n                contribute_seed seeds seed\n            : rust.ref (rust.mut' (am'.vec u8)) * am'.vec u8 -> ()\n        )\n\n:= roll_methods () : () =\n    global \"\"\"\n        #[near_sdk::near]\n        impl State {\n            pub fn generate_random_number(&mut self, key: String, proof: String, max: u64) -> u64 {\n                dice_contract_generate_random_number(&mut self.0.1, key, proof, max)\n            }\n        }\n        \"\"\"\n    export\n        \"dice_contract_generate_random_number\"\n        (\n            \\ (seeds, key, proof, max) =>\n                := () = quiet ()\n                generate_random_number seeds key proof max\n            : rust.ref (rust.mut' (am'.vec u8)) * sm'.std_string * sm'.std_string * u64 -> u64\n        )\n\n:= bound_methods () : () =\n    global \"\"\"\n        #[near_sdk::near]\n        impl State {\n            pub fn roll_within_bounds(max: u64, rolls: Vec<u8>) -> Option<u64> {\n                dice_contract_roll_within_bounds(max, rolls)\n            }\n            #[result_serializer(borsh)]\n            pub fn roll_within_bounds_borsh(\n                #[serializer(borsh)] max: u64,\n                #[serializer(borsh)] rolls: Vec<u8>,\n            ) -> Option<u64> {\n                Self::roll_within_bounds(max, rolls)\n            }\n        }\n        \"\"\"\n    export\n        \"dice_contract_roll_within_bounds\"\n        (\n            \\ (max, rolls) =>\n                := () = quiet ()\n                roll_within_bounds max rolls\n            : u64 * am'.vec u8 -> optionm'.option' u64\n        )\n\n:= main_native () : () =\n    near.bump_allocator ()\n    state_struct ()\n    legacy_state ()\n    init_methods ()\n    seed_methods ()\n    roll_methods ()\n    bound_methods ()\n\n:= main () =\n    ? is_rust ()\n    ?> main_native ()\n    |: ()",
  timeout: 300_000
)
