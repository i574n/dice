### main

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///> _\n\n// The NEAR contract (built by contract/build.ps1 with the Spiral compiler's Rust backend): each contract method's body\n// becomes a `pub fn` (`!!!!Export`, which makes the program a library crate), and the NEAR shell below (the contract's\n// state, its migration from `OldState` and the #[near_bindgen] methods) calls them.\ninl main_native () : () =\n    global \"#[derive(near_sdk::PanicOnDefault, borsh::BorshDeserialize, borsh::BorshSerialize)]\\npub struct OldState {\\n    version: u32,\\n    seeds: near_sdk::store::vec::Vector<u8>,\\n}\"\n    global \"#[near_sdk::near_bindgen]\\n#[derive(near_sdk::PanicOnDefault, borsh::BorshDeserialize, borsh::BorshSerialize)]\\npub struct State((u32, near_sdk::store::vec::Vector<u8>));\"\n    global \"impl From<OldState> for State {\\n    fn from(old_state: OldState) -> Self {\\n        Self((old_state.version + 1, old_state.seeds))\\n    }\\n}\"\n    global \"#[near_sdk::near_bindgen]\\nimpl State {\\n    #[init]\\n    pub fn new() -> Self {\\n        Self(dice_contract_new())\\n    }\\n    pub fn contribute_seed(&mut self, seed: Vec<u8>) {\\n        dice_contract_contribute_seed(&mut self.0.1, seed)\\n    }\\n    pub fn contribute_seed_borsh(&mut self, #[serializer(borsh)] seed: Vec<u8>) {\\n        self.contribute_seed(seed)\\n    }\\n    pub fn generate_random_number(&mut self, key: String, proof: String, max: u64) -> u64 {\\n        dice_contract_generate_random_number(&mut self.0.1, key, proof, max)\\n    }\\n    pub fn roll_within_bounds(&self, max: u64, rolls: Vec<u8>) -> Option<u64> {\\n        dice_contract_roll_within_bounds(max, rolls)\\n    }\\n    #[result_serializer(borsh)]\\n    pub fn roll_within_bounds_borsh(\\n        &self,\\n        #[serializer(borsh)] max: u64,\\n        #[serializer(borsh)] rolls: Vec<u8>,\\n    ) -> Option<u64> {\\n        self.roll_within_bounds(max, rolls)\\n    }\\n}\"\n    // Every export first sets the trace level to Info: lib.dice's per-roll `Debug` traces are only formatted when enabled,\n    // and with them a sandbox generate_random_number cost 35-93 Tgas instead of ~8 (on wasm32 the native trace gathers a\n    // call's lines into one log, capped at 16 KB). An Info+ trace would be dropped (a call's flush trace is Debug); this\n    // contract has none.\n    inl quiet () : () = set_trace_level Info\n    // `new` returns the state's fields: State (the near store vector) isn't Clone, and the Rust backend clones a returned\n    // variable of a macro type.\n    !!!!Export(\"dice_contract_new\", ((fun () => inl () = quiet () in inl x = new () in x.version, x.seeds) : () -> u32 * near.vector u8))\n    !!!!Export(\"dice_contract_contribute_seed\", ((fun (seeds, seed) => inl () = quiet () in contribute_seed seeds seed) : rust.ref (rust.mut' (near.vector u8)) * am'.vec u8 -> ()))\n    !!!!Export(\"dice_contract_generate_random_number\", ((fun (seeds, key, proof, max) => inl () = quiet () in generate_random_number seeds key proof max) : rust.ref (rust.mut' (near.vector u8)) * sm'.std_string * sm'.std_string * u64 -> u64))\n    !!!!Export(\"dice_contract_roll_within_bounds\", ((fun (max, rolls) => inl () = quiet () in roll_within_bounds max rolls) : u64 * am'.vec u8 -> optionm'.option' u64))\n\n\ninl main () =\n    if is_rust ()\n    then main_native ()\n    else ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///> _

  // The NEAR contract (built by contract/build.ps1 with the Spiral compiler's Rust backend): each contract method's body
  // becomes a `pub fn` (`!!!!Export`, which makes the program a library crate), and the NEAR shell below (the contract's
  // state, its migration from `OldState` and the #[near_bindgen] methods) calls them.
  inl main_native () : () =
      global "#[derive(near_sdk::PanicOnDefault, borsh::BorshDeserialize, borsh::BorshSerialize)]\npub struct OldState {\n    version: u32,\n    seeds: near_sdk::store::vec::Vector<u8>,\n}"
      global "#[near_sdk::near_bindgen]\n#[derive(near_sdk::PanicOnDefault, borsh::BorshDeserialize, borsh::BorshSerialize)]\npub struct State((u32, near_sdk::store::vec::Vector<u8>));"
      global "impl From<OldState> for State {\n    fn from(old_state: OldState) -> Self {\n        Self((old_state.version + 1, old_state.seeds))\n    }\n}"
      global "#[near_sdk::near_bindgen]\nimpl State {\n    #[init]\n    pub fn new() -> Self {\n        Self(dice_contract_new())\n    }\n    pub fn contribute_seed(&mut self, seed: Vec<u8>) {\n        dice_contract_contribute_seed(&mut self.0.1, seed)\n    }\n    pub fn contribute_seed_borsh(&mut self, #[serializer(borsh)] seed: Vec<u8>) {\n        self.contribute_seed(seed)\n    }\n    pub fn generate_random_number(&mut self, key: String, proof: String, max: u64) -> u64 {\n        dice_contract_generate_random_number(&mut self.0.1, key, proof, max)\n    }\n    pub fn roll_within_bounds(&self, max: u64, rolls: Vec<u8>) -> Option<u64> {\n        dice_contract_roll_within_bounds(max, rolls)\n    }\n    #[result_serializer(borsh)]\n    pub fn roll_within_bounds_borsh(\n        &self,\n        #[serializer(borsh)] max: u64,\n        #[serializer(borsh)] rolls: Vec<u8>,\n    ) -> Option<u64> {\n        self.roll_within_bounds(max, rolls)\n    }\n}"
      // Every export first sets the trace level to Info: lib.dice's per-roll `Debug` traces are only formatted when enabled,
      // and with them a sandbox generate_random_number cost 35-93 Tgas instead of ~8 (on wasm32 the native trace gathers a
      // call's lines into one log, capped at 16 KB). An Info+ trace would be dropped (a call's flush trace is Debug); this
      // contract has none.
      inl quiet () : () = set_trace_level Info
      // `new` returns the state's fields: State (the near store vector) isn't Clone, and the Rust backend clones a returned
      // variable of a macro type.
      !!!!Export("dice_contract_new", ((fun () => inl () = quiet () in inl x = new () in x.version, x.seeds) : () -> u32 * near.vector u8))
      !!!!Export("dice_contract_contribute_seed", ((fun (seeds, seed) => inl () = quiet () in contribute_seed seeds seed) : rust.ref (rust.mut' (near.vector u8)) * am'.vec u8 -> ()))
      !!!!Export("dice_contract_generate_random_number", ((fun (seeds, key, proof, max) => inl () = quiet () in generate_random_number seeds key proof max) : rust.ref (rust.mut' (near.vector u8)) * sm'.std_string * sm'.std_string * u64 -> u64))
      !!!!Export("dice_contract_roll_within_bounds", ((fun (max, rolls) => inl () = quiet () in roll_within_bounds max rolls) : u64 * am'.vec u8 -> optionm'.option' u64))


  inl main () =
      if is_rust ()
      then main_native ()
      else ()
  """,
  timeout: 300_000
)
```
