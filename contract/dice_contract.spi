///- --package ../dice

:< rust_operators
:< sm'_operators

test dice_contract static =
    :< testing

/// ## dice_contract
:== state =
    {
        version : u32
        seeds : am'.vec u8
    }

///> rust -c
test state =
    ()

///> rust -c
test state_2 =
    trace Verbose (\ () => "") id

:= empty_seeds () : am'.vec u8 =
    $'std::vec::Vec::<u8>::new()'

:= new () : state =
    {
        version = 3
        seeds = empty_seeds ()
    }

///> rust -c
test new =
    := state = new ()
    trace Verbose (\ () => "dice_contract") \ () => { state = #?*state }
    trace Verbose (\ () => "") id

:= max_seeds () : convert.unativeint =
    100i32 |> convert.convert

:= hex (bytes : am'.vec u8) : string =
    $'{ const D: &[u8; 16] = b"0123456789abcdef"; let b = &(!bytes); let mut s = std::string::String::with_capacity(b.len() * 2); for x in b.iter() { s.push(D[(*x >> 4) as usize] as char); s.push(D[(*x & 15) as usize] as char); } std::rc::Rc::<str>::from(s) }'

///> rust -c
test hex =
    ;[ 0u8; 15; 16; 171; 255 ] |> am'.base |> am'.to_vec
    |> hex
    |> _assert_eq "000f10abff"

:= append_seed (seeds : rust.ref (rust.mut' (am'.vec u8))) (seed : am'.vec u8) : am'.vec u8 =
    := max = max_seeds ()
    $'{ let s = &mut *(!seeds); s.extend_from_slice(&(!seed)); let excess = s.len().saturating_sub(!max); s.drain(..excess).collect::<std::vec::Vec<u8>>() }'

:= contribute_seed (seeds : rust.ref (rust.mut' (am'.vec u8))) (seed : am'.vec u8) : () =
    := seed_len = seed |> am'.vec_len
    := seed_excess = seed |> append_seed seeds
    trace Debug
        \ () => "dice_contract.contribute_seed"
        \ () => { seed_len seed_excess = seed_excess |> hex }
    trace Debug (\ () => "") (~~ id)

///> rust -c
test contribute_seed =
    := replicate n =
        :~ ^ 루프 i acc =
            ? i > n
            ?> acc
            |:
                := i' = i % 10
                := i' =
                    ? i' = 0
                    ?> i % limit.max
                    |: i'
                루프 (i + 1) (i' :: acc)
        루프 1 []
        |> listm.rev
        |> listm'.box
        |> listm'.to_array'

    := max_seeds : u32 = max_seeds () |> convert.convert
    := seeds = empty_seeds () |> rust.to_ref_mut

    conv max_seeds * 1.2f64
    |> replicate
    |> am'.map_base convert.u8
    |> am'.to_vec
    |> contribute_seed seeds

    seeds
    |> rust.len
    |> _assert_eq max_seeds

:= largest_bound () : u64 =
    4738381338321616896u64

:= hash_word (hash : am'.vec u8) (index : u64) : u64 =
    $'(0..8usize).fold(0u64, |w, j| w | (u64::from((!hash)[(8 * (!index) as usize + j) % (!hash).len()]) << (8 * j)))'

:= uniform_from_hash (max : u64) (hash : am'.vec u8) : u64 =
    := last_accepted = limit.max - (limit.max - max + 1u64) % max
    :~ ^ 루프 (hash : am'.vec u8) (index : u64) : u64 =
        ? index >= 8u64
        ?> 루프 (hash |> near.keccak512) 0u64
        |:
            := word = hash_word hash index
            ? word <= last_accepted
            ?> word % max + 1u64
            |: 루프 hash (index + 1u64)
    루프 hash 0u64

:= fail (text : string) : u64 =
    $'{ \#[cfg(target_arch = "wasm32")] near_sdk::env::panic_str(&*(!text)); \#[cfg(not(target_arch = "wasm32"))] std::panic::panic_any::<std::string::String>((!text).to_string()) }'

:= generate_random_number
    (seeds : rust.ref (rust.mut' (am'.vec u8)))
    (key : sm'.std_string)
    (proof : sm'.std_string)
    (max : u64)
    : u64
    =
    ? max = 0u64
    ?> fail "dice_contract.generate_random_number / max must be at least 1"
    |? max > largest_bound ()
    ?>
        fail (
            "dice_contract.generate_random_number / max: " ++# #?max
            ++# " is above the largest supported bound " ++# #?(largest_bound ())
        )
    |:
        := seed = near.random_seed ()
        := epoch_height = near.epoch_height ()
        := block_height = near.block_height ()
        := block_timestamp = near.block_timestamp ()
        := account_balance = near.account_balance ()
        := signer_account_id = near.signer_account_id ()
        := predecessor_account_id = near.predecessor_account_id ()
        := seeds_before : am'.vec u8 = $'(!seeds).clone()'
        := entropy =
            ;[
                seed
                seeds_before
                epoch_height |> am'.to_le_bytes |> am'.to_vec'
                block_height |> am'.to_le_bytes |> am'.to_vec'
                block_timestamp |> am'.to_le_bytes |> am'.to_vec'
                account_balance |> near.as_yoctonear |> am'.to_le_bytes |> am'.to_vec'
                signer_account_id |> am'.as_bytes |> am'.to_vec''
                predecessor_account_id |> am'.as_bytes |> am'.to_vec''
                proof |> sm'.into_bytes
                key |> sm'.into_bytes
            ]
            |> am'.base
            |> am'.to_vec
            |> rust.concat
        := hash = entropy |> near.keccak512
        hash |> append_seed seeds |> ignore
        := result = hash |> uniform_from_hash max
        trace Debug
            \ () => "dice_contract.generate_random_number"
            \ () => {
                max
                result
                key
                proof
                block_timestamp
                block_height
                epoch_height
                account_balance = account_balance |> near.as_yoctonear |> sm'.format_debug
                signer_account_id = signer_account_id |> sm'.to_string'
                predecessor_account_id = predecessor_account_id |> sm'.to_string'
                seed = seed |> hex
                seeds = seeds_before |> hex
                hash = hash |> hex
            }
        trace Debug (\ () => "") (~~ id)
        result

///> rust -c
test uniform_from_hash =
    := hash = ;[ 255u8; 255; 255; 255; 255; 255; 255; 255; 7; 0; 0; 0; 0; 0; 0; 0 ] |> am'.base |> am'.to_vec
    hash
    |> uniform_from_hash 6
    |> _assert_eq 2

///> rust -c
test uniform_from_hash_2 =
    := hash = ;[ 255u8; 255; 255; 255; 255; 255; 255; 255 ] |> am'.base |> am'.to_vec
    hash
    |> uniform_from_hash 1
    |> _assert_eq 1

///> rust -cd near-token
test generate_random_number =
    := seeds = empty_seeds () |> rust.to_ref_mut
    2000
    |> generate_random_number
        seeds
        ("" |> sm'.to_std_string)
        ("" |> sm'.to_std_string)
    |> _assert_gt 0

:= roll_within_bounds (max : u64) (rolls : am'.vec u8) : optionm'.option' u64 =
    := result =
        rolls
        |> am'.from_vec_base
        |> am'.to_list_base'
        |> listm'.unbox
        |> lib.dice.roll_within_bounds max
        |> optionm'.box
    trace Debug
        \ () => "dice_contract.roll_within_bounds"
        \ () => { max rolls = #?*rolls; result = #?*result }
    trace Debug (\ () => "") (~~ id)
    result

///> rust -c
test roll_within_bounds =
    := rolls = ;[ 1; 5; 4; 4; 5 ] |> am'.base |> am'.to_vec

    rolls
    |> roll_within_bounds 2000
    |> _assert_eq' (optionm'.some' 995)

///> rust -c
test roll_within_bounds_2 =
    := rolls = ;[ 2; 2; 6; 4; 5 ] |> am'.base |> am'.to_vec

    rolls
    |> roll_within_bounds 2000
    |> _assert_eq' (optionm'.some' 1715)

/// ### main
///> _

:= main_native () : () =
    global """
        #[derive(near_sdk::PanicOnDefault, borsh::BorshDeserialize, borsh::BorshSerialize)]
        pub struct OldState {
            version: u32,
            seeds: near_sdk::store::vec::Vector<u8>,
        }
        """
    global """
        #[near_sdk::near(contract_state)]
        #[derive(near_sdk::PanicOnDefault)]
        pub struct State((u32, Vec<u8>));
        """
    global """
        impl From<OldState> for State {
            fn from(mut old_state: OldState) -> Self {
                let seeds = old_state.seeds.iter().copied().collect();
                old_state.seeds.clear();
                old_state.seeds.flush();
                Self((old_state.version + 1, seeds))
            }
        }
        """
    global """
        #[near_sdk::near]
        impl State {
            #[init]
            pub fn new() -> Self {
                Self(dice_contract_new())
            }
            #[private]
            #[init(ignore_state)]
            pub fn migrate() -> Self {
                let raw = near_sdk::env::storage_read(b"STATE")
                    .unwrap_or_else(|| near_sdk::env::panic_str("dice_contract.migrate / no state to migrate"));
                if raw.len() >= 4 && u32::from_le_bytes([raw[0], raw[1], raw[2], raw[3]]) >= 3 {
                    near_sdk::env::panic_str("dice_contract.migrate / the state is already migrated")
                }
                borsh::from_slice::<OldState>(&raw)
                    .unwrap_or_else(|_| near_sdk::env::panic_str("dice_contract.migrate / the state is not the old layout"))
                    .into()
            }
            pub fn contribute_seed(&mut self, seed: Vec<u8>) {
                dice_contract_contribute_seed(&mut self.0.1, seed)
            }
            pub fn contribute_seed_borsh(&mut self, #[serializer(borsh)] seed: Vec<u8>) {
                self.contribute_seed(seed)
            }
            pub fn generate_random_number(&mut self, key: String, proof: String, max: u64) -> u64 {
                dice_contract_generate_random_number(&mut self.0.1, key, proof, max)
            }
            pub fn roll_within_bounds(max: u64, rolls: Vec<u8>) -> Option<u64> {
                dice_contract_roll_within_bounds(max, rolls)
            }
            #[result_serializer(borsh)]
            pub fn roll_within_bounds_borsh(
                #[serializer(borsh)] max: u64,
                #[serializer(borsh)] rolls: Vec<u8>,
            ) -> Option<u64> {
                Self::roll_within_bounds(max, rolls)
            }
        }
        """
    := quiet () : () = set_trace_level Debug
    export
        "dice_contract_new"
        ((\ () => := () = quiet () ;; := x = new () ;; x.version, x.seeds) : () -> u32 * am'.vec u8)
    export
        "dice_contract_contribute_seed"
        (
            \ (seeds, seed) =>
                := () = quiet ()
                contribute_seed seeds seed
            : rust.ref (rust.mut' (am'.vec u8)) * am'.vec u8 -> ()
        )
    export
        "dice_contract_generate_random_number"
        (
            \ (seeds, key, proof, max) =>
                := () = quiet ()
                generate_random_number seeds key proof max
            : rust.ref (rust.mut' (am'.vec u8)) * sm'.std_string * sm'.std_string * u64 -> u64
        )
    export
        "dice_contract_roll_within_bounds"
        (
            \ (max, rolls) =>
                := () = quiet ()
                roll_within_bounds max rolls
            : u64 * am'.vec u8 -> optionm'.option' u64
        )


:= main () =
    ? is_rust ()
    ?> main_native ()
    |: ()

///> rust -d "near-sdk={version='=5.11.0',features=['unit-testing']}" -d near-token
test generate_random_number_is_deterministic_under_a_mocked_context =
    := mocked () : () =
        $'near_sdk::testing_env!!(near_sdk::test_utils::VMContextBuilder::new().random_seed([7u8; \
            32]).block_timestamp(1_700_000_000_000_000_000).build())' : ()
    := draw () : u64 =
        mocked ()
        2000
        |> generate_random_number
            (empty_seeds () |> rust.to_ref_mut)
            ("" |> sm'.to_std_string)
            ("" |> sm'.to_std_string)
    := first = draw ()
    := second = draw ()
    (first = second, first > 0) |> _assert_eq (!+, !+)

///> rust -d "near-sdk={version='=5.11.0',features=['unit-testing']}" -d near-token
test generate_random_number_reports_its_gas_under_a_mocked_context =
    := mocked () : () =
        $'near_sdk::testing_env!!(near_sdk::test_utils::VMContextBuilder::new().random_seed([7u8; \
            32]).block_timestamp(1_700_000_000_000_000_000).build())' : ()
    := used () : u64 = $'near_sdk::env::used_gas().as_gas()' : u64
    mocked ()
    := before = used ()
    := _drawn =
        2000
        |> generate_random_number
            (empty_seeds () |> rust.to_ref_mut)
            ("" |> sm'.to_std_string)
            ("" |> sm'.to_std_string)
    := gas = used () - before
    (gas > 0u64, gas < 300000000000000u64) |> _assert_eq (!+, !+)
