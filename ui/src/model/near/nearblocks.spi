:< rust_operators



:== block =
    {
        block_height : u32
    }

:== action =
    {
        action : sm'.std_string
        method : optionm'.option' sm'.std_string
    }

:== actions_agg =
    {
        deposit : f64
    }

:== outcomes =
    {
        status : bool
    }

:== outcomes_agg =
    {
        transaction_fee : f64
    }

:== txn =
    {
        receipt_id : sm'.std_string
        predecessor_account_id : sm'.std_string
        receiver_account_id : sm'.std_string
        transaction_hash : sm'.std_string
        included_in_block_hash : sm'.std_string
        block_timestamp : sm'.std_string
        block : block
        actions : array_base action
        actions_agg : actions_agg
        outcomes : outcomes
        outcomes_agg : outcomes_agg
        logs : array_base sm'.std_string
    }

:== root =
    {
        txns : array_base txn
    }

:== action_wire =
    {
        action : string
        method : option string
    }

:== txn_wire =
    {
        receipt_id : string
        predecessor_account_id : string
        receiver_account_id : string
        transaction_hash : string
        included_in_block_hash : string
        block_timestamp : string
        block : block
        actions : array_base action_wire
        actions_agg : actions_agg
        outcomes : outcomes
        outcomes_agg : outcomes_agg
        logs : option (array_base string)
    }

:== root_wire =
    {
        txns : array_base txn_wire
    }

:= action_of ({ action method } : action_wire) : action =
    {
        action = sm'.to_std_string action
        method = method |> optionm.map sm'.to_std_string |> optionm'.box
    }

:= logs_of (logs : option (array_base string)) : array_base sm'.std_string =
    ?= logs ?|
    | Some xs => xs |> am'.map_base sm'.to_std_string
    | None => ;[] |> am'.base

:= txn_of (w : txn_wire) : txn =
    {
        receipt_id = sm'.to_std_string w.receipt_id
        predecessor_account_id = sm'.to_std_string w.predecessor_account_id
        receiver_account_id = sm'.to_std_string w.receiver_account_id
        transaction_hash = sm'.to_std_string w.transaction_hash
        included_in_block_hash = sm'.to_std_string w.included_in_block_hash
        block_timestamp = sm'.to_std_string w.block_timestamp
        block = w.block
        actions = w.actions |> am'.map_base action_of
        actions_agg = w.actions_agg
        outcomes = w.outcomes
        outcomes_agg = w.outcomes_agg
        logs = logs_of w.logs
    }

:= decode_root (text : string) : resultm.result' root sm'.std_string =
    := wire : root_wire = json.decode text
    { txns = wire.txns |> am'.map_base txn_of } |> Ok |> resultm.box
