:< rust.rust_operators
:< sm'_operators


:! rpc_input' = $'crate::model::near::rpc::RpcInput'

:! error_cause_info' = $'crate::model::near::rpc::ErrorCauseInfo'

:! error_cause' = $'crate::model::near::rpc::ErrorCause'

:! rpc_error' = $'crate::model::near::rpc::RpcError'

:! transfer_detail' = $'crate::model::near::rpc::TransferDetail'

:! gas_profile' = $'crate::model::near::rpc::GasProfile'

:! metadata' = $'crate::model::near::rpc::Metadata'

:! outcome_detail' = $'crate::model::near::rpc::OutcomeDetail'

:! proof' = $'crate::model::near::rpc::Proof'

:! receipts_outcome' = $'crate::model::near::rpc::ReceiptsOutcome'

:! action_detail' = $'crate::model::near::rpc::ActionDetail'

:! receipt_detail' = $'crate::model::near::rpc::ReceiptDetail'

:! receipt' = $'crate::model::near::rpc::Receipt'

:! transaction_status' = $'crate::model::near::rpc::TransactionStatus'

:! rpc_response' = $'crate::model::near::rpc::RpcResponse'

:== rpc_input =
    {
        jsonrpc : sm'.std_string
        id : sm'.std_string
        method : sm'.std_string
        params : array sm'.std_string
    }

:== error_cause_info =
    {
        error_message : optionm'.option' sm'.std_string
        requested_transaction_hash : optionm'.option' sm'.std_string
    }

:== error_cause =
    {
        name : sm'.std_string
        info : optionm'.option' error_cause_info
    }

:== rpc_error =
    {
        name : sm'.std_string
        cause : error_cause
        code : i32
        message : sm'.std_string
        data : sm'.std_string
    }

:== transfer_detail =
    {
        deposit : sm'.std_string
        args : optionm'.option' sm'.std_string
        gas : optionm'.option' f64
        method_name : optionm'.option' sm'.std_string
    }

:== gas_profile =
    {
        cost : sm'.std_string
        cost_category : sm'.std_string
        gas_used : sm'.std_string
    }

:== metadata =
    {
        gas_profile : array_base gas_profile
        version : u8
    }

:== outcome_detail =
    {
        executor_id : sm'.std_string
        gas_burnt : u64
        logs : array_base sm'.std_string
        metadata : metadata
        receipt_ids : array_base sm'.std_string
        status : mapm.hash_map sm'.std_string sm'.std_string
        tokens_burnt : optionm'.option' sm'.std_string
    }

:== proof =
    {
        direction : sm'.std_string
        hash : sm'.std_string
    }

:== receipts_outcome =
    {
        block_hash : sm'.std_string
        id : sm'.std_string
        outcome : outcome_detail
        proof : array_base proof
    }

:== action_detail =
    {
        actions : array_base (mapm.hash_map sm'.std_string transfer_detail)
        gas_price : sm'.std_string
        input_data_ids : array_base sm'.std_string
        output_data_receivers : array_base sm'.std_string
        signer_id : sm'.std_string
        signer_public_key : sm'.std_string
    }

:== receipt_detail =
    {
        action : action_detail
    }

:== receipt =
    {
        predecessor_id : sm'.std_string
        receipt : receipt_detail
        receipt_id : sm'.std_string
        receiver_id : sm'.std_string
    }

:== transaction_status =
    {
        receipts : array_base receipt
        receipts_outcome : array_base receipts_outcome
    }

:== result =
    {
        final_execution_status : sm'.std_string
        receipts : array_base receipt
    }

:== rpc_response =
    {
        jsonrpc : sm'.std_string
        result : optionm'.option' transaction_status
        error : optionm'.option' rpc_error
        id : optionm'.option' sm'.std_string
    }

:= format_error (error : _ rpc_error) =
    ?= error |> optionm'.unbox ?|
    | Some { cause = { name = cause_name } data name message } =>
        := text = sm'.from_std_string
        text name ++# ": " ++# text message ++# " - " ++# text data ++# " (" ++# text cause_name ++# ")"
        |> Some
    | _ => None

:= rpc_input_box ({ jsonrpc id method params } : rpc_input) : rpc_input' =
    := params = params |> am'.base |> am'.to_vec
    !\\((jsonrpc, id, method), $'"crate::model::near::rpc::RpcInput { jsonrpc: $0, id: $1, method: $2, \
        params: !params }"')

:= error_cause_info_box ({ error_message requested_transaction_hash } : error_cause_info) : error_cause_info' =
    !\($'"crate::model::near::rpc::ErrorCauseInfo { error_message: !error_message, \
        requested_transaction_hash: !requested_transaction_hash }"')

:= error_cause_box ({ name info } : error_cause) : error_cause' =
    := info = info |> optionm'.map'' error_cause_info_box
    !\($'"crate::model::near::rpc::ErrorCause { name: !name, info: !info }"')

:= rpc_error_box ({ name cause code message data } : rpc_error) : rpc_error' =
    := cause = cause |> error_cause_box
    !\($'"crate::model::near::rpc::RpcError { name: !name, cause: !cause, code: !code, message: !message, \
        data: !data }"')

:= transfer_detail_box ({ deposit args gas method_name } : transfer_detail) : transfer_detail' =
    !\($'"crate::model::near::rpc::TransferDetail { deposit: !deposit, args: !args, gas: !gas, \
        method_name: !method_name }"')

:= gas_profile_box ({ cost cost_category gas_used } : gas_profile) : gas_profile' =
    !\($'"crate::model::near::rpc::GasProfile { cost: !cost, cost_category: !cost_category, gas_used: !gas_used }"')

:= metadata_box ({ gas_profile version } : metadata) : metadata' =
    := gas_profile = gas_profile |> am'.to_vec
    !\($'"crate::model::near::rpc::Metadata { gas_profile: !gas_profile, version: !version }"')

:= outcome_detail_box
    ({ executor_id gas_burnt logs metadata receipt_ids status tokens_burnt } : outcome_detail)
    : outcome_detail'
    =
    := logs = logs |> am'.to_vec
    := receipt_ids = receipt_ids |> am'.to_vec
    !\($'"crate::model::near::rpc::OutcomeDetail { executor_id: !executor_id, gas_burnt: !gas_burnt, logs: !logs, \
        metadata: !metadata, receipt_ids: !receipt_ids, status: !status, tokens_burnt: !tokens_burnt }"')

:= proof_box ({ direction hash } : proof) : proof' =
    !\($'"crate::model::near::rpc::Proof { direction: !direction, hash: !hash }"')

:= receipts_outcome_box ({ block_hash id outcome proof } : receipts_outcome) : receipts_outcome' =
    := outcome = outcome |> outcome_detail_box
    := proof = proof |> am'.to_vec |> am'.vec_map' proof_box |> optionm'.some'
    !\($'"crate::model::near::rpc::ReceiptsOutcome { block_hash: !block_hash, id: !id, outcome: !outcome, \
        proof: !proof }"')

:= action_detail_box
    ({ actions gas_price input_data_ids output_data_receivers signer_id signer_public_key } : action_detail)
    : action_detail'
    =
    := actions = actions |> am'.to_vec
    := input_data_ids = input_data_ids |> am'.to_vec
    := output_data_receivers = output_data_receivers |> am'.to_vec
    !\($'"crate::model::near::rpc::ActionDetail { actions: !actions, gas_price: !gas_price, \
        input_data_ids: !input_data_ids, output_data_receivers: !output_data_receivers, signer_id: !signer_id, \
        signer_public_key: !signer_public_key }"')

:= receipt_detail_box ({ action } : receipt_detail) : receipt_detail' =
    := action = action |> action_detail_box
    !\($'"crate::model::near::rpc::ReceiptDetail { action: !action }"')

:= receipt_box ({ predecessor_id receipt receipt_id receiver_id } : receipt) : receipt' =
    := receipt = receipt |> receipt_detail_box
    !\($'"crate::model::near::rpc::Receipt { predecessor_id: !predecessor_id, receipt: !receipt, \
        receipt_id: !receipt_id, receiver_id: !receiver_id }"')

:= transaction_status_box ({ receipts receipts_outcome } : transaction_status) : transaction_status' =
    := receipts = receipts |> am'.to_vec
    := receipts_outcome = receipts_outcome |> am'.to_vec
    !\($'"crate::model::near::rpc::TransactionStatus { receipts: !receipts, receipts_outcome: !receipts_outcome }"')

:= rpc_response_box ({ jsonrpc result error id } : rpc_response) : rpc_response' =
    := result = result |> optionm'.map'' transaction_status_box
    := error = error |> optionm'.map'' rpc_error_box
    !\($'"crate::model::near::rpc::RpcResponse { jsonrpc: !jsonrpc, result: !result, error: !error, id: !id }"')

:= rpc_input_unbox (x : rpc_input') : rpc_input =
    := jsonrpc = !\\(x, $'"$0.jsonrpc"')
    := id = !\\(x, $'"$0.id"')
    := method = !\\(x, $'"$0.method"')
    := params =
        !\\(x, $'"$0.params"')
        |> am'.from_vec
        |> \ (x : array _) => ~~ x
    { jsonrpc; id; method; params }

:= error_cause_info_unbox (x : error_cause_info') : error_cause_info =
    := error_message = !\\(x, $'"$0.error_message"')
    := requested_transaction_hash = !\\(x, $'"$0.requested_transaction_hash"')
    { error_message; requested_transaction_hash }

:= error_cause_unbox (x : error_cause') : error_cause =
    := name = !\\(x, $'"$0.name"')
    := info = !\\(x, $'"$0.info"') |> optionm'.map'' error_cause_info_unbox
    { name; info }

:= rpc_error_unbox (x : rpc_error') : rpc_error =
    := name = !\\(x, $'"$0.name"')
    := cause = !\\(x, $'"$0.cause"') |> error_cause_unbox
    := code = !\\(x, $'"$0.code"')
    := message = !\\(x, $'"$0.message"')
    := data = !\\(x, $'"$0.data"')
    { name; cause; code; message; data }

:= transfer_detail_unbox (x : transfer_detail') : transfer_detail =
    := deposit = !\\(x, $'"$0.deposit"')
    := args = !\\(x, $'"$0.args"')
    := gas = !\\(x, $'"$0.gas"')
    := method_name = !\\(x, $'"$0.method_name"')
    { deposit args gas method_name }

:= gas_profile_unbox (x : gas_profile') : gas_profile =
    := cost = !\\(x, $'"$0.cost"')
    := cost_category = !\\(x, $'"$0.cost_category"')
    := gas_used = !\\(x, $'"$0.gas_used"')
    { cost; cost_category; gas_used }

:= metadata_unbox (x : metadata') : metadata =
    := gas_profile =
        !\\(x, $'"$0.gas_profile"')
        |> am'.vec_map' gas_profile_unbox
        |> am'.from_vec
        |> \ (array x : array _) => x
    := version = !\\(x, $'"$0.version"')
    { gas_profile; version }

:= outcome_detail_unbox (x : outcome_detail') : outcome_detail =
    := executor_id = !\\(x, $'"$0.executor_id"')
    := gas_burnt = !\\(x, $'"$0.gas_burnt"')
    := logs = !\\(x, $'"$0.logs"') |> am'.from_vec |> \ (array x : array _) => x
    := metadata = !\\(x, $'"$0.metadata"') |> metadata_unbox
    := receipt_ids = !\\(x, $'"$0.receipt_ids"') |> am'.from_vec |> \ (array x : array _) => x
    := status = !\\(x, $'"$0.status"')
    := tokens_burnt = !\\(x, $'"$0.tokens_burnt"')
    { executor_id gas_burnt logs metadata receipt_ids status tokens_burnt }

:= proof_unbox (x : proof') : proof =
    := direction = !\\(x, $'"$0.direction"')
    := hash = !\\(x, $'"$0.hash"')
    { direction hash }

:= receipts_outcome_unbox (x : receipts_outcome') : receipts_outcome =
    := block_hash = !\\(x, $'"$0.block_hash"')
    := id = !\\(x, $'"$0.id"')
    := outcome = !\\(x, $'"$0.outcome"') |> outcome_detail_unbox
    := proof =
        !\\(x, $'"$0.proof"')
        |> optionm'.map'' (am'.vec_map' proof_unbox >> am'.from_vec >> \ (array x : array _) => x)
        |> optionm'.default_value' (;[] |> am'.base)
    { block_hash id outcome proof }

:= action_detail_unbox (x : action_detail') : action_detail =
    := actions =
        !\\(x, $'"$0.actions"')
        |> am'.vec_map' (mapm.map' transfer_detail_unbox)
        |> am'.from_vec
        |> \ (array x : array _) => x
    := gas_price = !\\(x, $'"$0.gas_price"')
    := input_data_ids = !\\(x, $'"$0.input_data_ids"') |> am'.from_vec |> \ (array x : array _) => x
    := output_data_receivers = !\\(x, $'"$0.output_data_receivers"') |> am'.from_vec |> \ (array x : array _) => x
    := signer_id = !\\(x, $'"$0.signer_id"')
    := signer_public_key = !\\(x, $'"$0.signer_public_key"')
    { actions; gas_price; input_data_ids; output_data_receivers; signer_id; signer_public_key }

:= receipt_detail_unbox (x : receipt_detail') : receipt_detail =
    := action = !\\(x, $'"$0.action"') |> action_detail_unbox
    { action }

:= receipt_unbox (x : receipt') : receipt =
    := predecessor_id = !\\(x, $'"$0.predecessor_id"')
    := receipt = !\\(x, $'"$0.receipt"') |> receipt_detail_unbox
    := receipt_id = !\\(x, $'"$0.receipt_id"')
    := receiver_id = !\\(x, $'"$0.receiver_id"')
    { predecessor_id; receipt; receipt_id; receiver_id }

:= transaction_status_unbox (x : transaction_status') : transaction_status =
    := receipts =
        !\\(x, $'"$0.receipts"')
        |> am'.vec_map' receipt_unbox
        |> am'.from_vec
        |> \ (array x : array _) => x
    := receipts_outcome =
        !\\(x, $'"$0.receipts_outcome"')
        |> am'.vec_map' receipts_outcome_unbox
        |> am'.from_vec
        |> \ (array x : array _) => x
    { receipts; receipts_outcome }

:= rpc_response_unbox (x : rpc_response') : rpc_response =
    := jsonrpc = !\\(x, $'"$0.jsonrpc"')
    := result = !\\(x, $'"$0.result"') |> optionm'.map'' transaction_status_unbox
    := error = !\\(x, $'"$0.error"') |> optionm'.map'' rpc_error_unbox
    := id = !\\(x, $'"$0.id"')
    { jsonrpc; result; error; id }
