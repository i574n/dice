:< rust.rust_operators
:< sm'_operators
:< leptos
:< model.near.nearblocks

:= action_render action method =
    ui.grid_pair.render
        \ props => { props ?|
            class = \ () => ""
            cols_class = \ () => ""
            dd_class = \ () => ""
            padding_class = \ () => "items-center"
        }
        \ () =>
            ?= action |> sm'.from_std_string ?|
            | "FUNCTION_CALL" => "Function Call:"
            | "DEPLOY_CONTRACT" => "Contract Deploy:"
            | "TRANSFER" => "Transfer:"
            | action => action
            |> leptos.text_fragment
        \ () =>
            leptos.div [
                "class=\"flex flex-1 flex-col\""
            ] \ () => :>[
                ui.grid_pair.render
                    \ props => { props ?|
                        class = \ () => ""
                        dd_class = \ () => ""
                        padding_class = \ () => ""
                    }
                    \ () => "Method" |> leptos.text_fragment
                    \ () =>
                        ?= method |> optionm'.unbox ?|
                        | Some method =>
                            method
                            |> to_string
                            |> leptos.text_fragment
                        | None =>
                            "None" |> leptos.text_fragment
                |> leptos.element_to_view
            ]
            |> leptos.element_to_fragment

:= tr_head_render (transactions : array_base hooks.use_transactions.account_transaction) =
    print_static "<transaction.tr_head_render>"
    leptos.log "transaction.tr_head_render (1)"

    leptos.tr [

    ] \ () =>
        :>[
            leptos.th [
                "class=\"whitespace-nowrap px-4 py-2 font-medium text-gray-900 dark:text-white\""
            ] \ () =>
                "Account" |> leptos.text_fragment
            |> leptos.element_to_view

            leptos.th [
                "class=\"whitespace-nowrap px-4 py-2 font-medium text-gray-900 dark:text-white\""
            ] \ () =>
                "Block Timestamp" |> leptos.text_fragment
            |> leptos.element_to_view

            leptos.th [
                "class=\"whitespace-nowrap px-4 py-2 font-medium text-gray-900 dark:text-white\""
            ] \ () =>
                "Predecessor" |> leptos.text_fragment
            |> leptos.element_to_view

            leptos.th [
                "class=\"whitespace-nowrap px-4 py-2 font-medium text-gray-900 dark:text-white\""
            ] \ () =>
                "Receiver" |> leptos.text_fragment
            |> leptos.element_to_view

            leptos.th [
                "class=\"whitespace-nowrap px-4 py-2 font-medium text-gray-900 dark:text-white\""
            ] \ () =>
                "Action" |> leptos.text_fragment
            |> leptos.element_to_view

            leptos.th [
                "class=\"whitespace-nowrap px-4 py-2 font-medium text-gray-900 dark:text-white\""
            ] \ () =>
                "Deposit" |> leptos.text_fragment
            |> leptos.element_to_view

            leptos.th [
                "class=\"whitespace-nowrap px-4 py-2 font-medium text-gray-900 dark:text-white\""
            ] \ () =>
                "Fee" |> leptos.text_fragment
            |> leptos.element_to_view

            leptos.th [
                "class=\"whitespace-nowrap px-4 py-2 font-medium text-gray-900 dark:text-white\""
            ] \ () =>
                "Block Height" |> leptos.text_fragment
            |> leptos.element_to_view

            leptos.th [
                "class=\"whitespace-nowrap px-4 py-2 font-medium text-gray-900 dark:text-white\""
            ] \ () =>
                (array transactions : array _)
                |> arraym.exists' \ { txn } =>
                    (array txn.logs : array _)
                    |> arraym.exists' \ log =>
                        (log |> sm'.from_std_string |> sm.length) > 0i32
                |> \|
                    | !- => ""
                    | _ => "Logs"
                    |> leptos.text_fragment
            |> leptos.element_to_view

            leptos.th [
                "class=\"whitespace-nowrap px-4 py-2 font-medium text-gray-900 dark:text-white\""
            ] \ () =>
                "Outcome Status" |> leptos.text_fragment
            |> leptos.element_to_view

            leptos.th [
                "class=\"whitespace-nowrap px-4 py-2 font-medium text-gray-900 dark:text-white\""
            ] \ () =>
                "Hash" |> leptos.text_fragment
            |> leptos.element_to_view

            leptos.th [
                "class=\"whitespace-nowrap px-4 py-2 font-medium text-gray-900 dark:text-white\""
            ] \ () =>
                "Block Hash" |> leptos.text_fragment
            |> leptos.element_to_view

            leptos.th [
                "class=\"whitespace-nowrap px-4 py-2 font-medium text-gray-900 dark:text-white\""
            ] \ () =>
                "Receipt ID" |> leptos.text_fragment
            |> leptos.element_to_view
        ]

:= tr_render ({ account txn } : hooks.use_transactions.account_transaction) =
    print_static "<transaction.tr_render>"
    leptos.log "transaction.tr_render (1)"

    leptos.tr [
        "class=\"odd:bg-gray-50 dark:odd:bg-gray-800/50\""
    ] \ () =>
        :>[
            leptos.td [
                "class=\"whitespace-nowrap px-4 py-2 text-gray-700 dark:text-gray-500\""
            ] \ () =>
                account
                |> leptos.text_fragment
            |> leptos.element_to_view

            leptos.td [
                "class=\"whitespace-nowrap px-4 py-2 text-gray-700 dark:text-gray-500\""
            ] \ () =>
                txn.block_timestamp
                |> sm'.from_std_string
                |> convert.i64
                |> date_time.format_timestamp
                |> to_string
                |> leptos.text_fragment
            |> leptos.element_to_view

            leptos.td [
                "class=\"whitespace-nowrap px-4 py-2 text-gray-700 dark:text-gray-500\""
            ] \ () =>
                txn.predecessor_account_id
                |> to_string
                |> leptos.text_fragment
            |> leptos.element_to_view

            leptos.td [
                "class=\"whitespace-nowrap px-4 py-2 text-gray-700 dark:text-gray-500\""
            ] \ () =>
                txn.receiver_account_id
                |> to_string
                |> leptos.text_fragment
            |> leptos.element_to_view

            leptos.td [
                "class=\"whitespace-nowrap px-4 py-2 text-gray-700 dark:text-gray-500\""
            ] \ () =>
                txn.actions
                |> am'.to_vec
                |> am'.vec_map \ { action method } =>
                    action_render action method
                    |> leptos.element_to_view
                |> leptos.vec_to_view
                |> leptos.view_to_fragment
            |> leptos.element_to_view

            leptos.td [
                "class=\"whitespace-nowrap px-4 py-2 text-gray-700 dark:text-gray-500\""
            ] \ () =>
                txn.actions_agg.deposit
                |> sm'.obj_to_string
                |> leptos.text_fragment
            |> leptos.element_to_view

            leptos.td [
                "class=\"whitespace-nowrap px-4 py-2 text-gray-700 dark:text-gray-500\""
            ] \ () =>
                txn.outcomes_agg.transaction_fee
                |> sm'.obj_to_string
                |> leptos.text_fragment
            |> leptos.element_to_view

            leptos.td [
                "class=\"whitespace-nowrap px-4 py-2 text-gray-700 dark:text-gray-500\""
            ] \ () =>
                txn.block.block_height
                |> sm'.obj_to_string
                |> leptos.text_fragment
            |> leptos.element_to_view

            leptos.td [
                "class=\"whitespace-nowrap px-4 py-2 text-gray-700 dark:text-gray-500 [overflow:auto]\""
            ] \ () =>
                ?= txn.logs ?|
                | ;[] => "" |> leptos.text_fragment
                | _ =>
                    txn.logs
                    |> am'.to_vec
                    |> am'.vec_map' sm'.from_std_string
                    |> am'.from_vec
                    |> \ x => x : array _
                    |> seq.of_array
                    |> sm'.concat "\n"
                    |> sm'.replace "\\n" "\n"
                    |> ui.text_block_pre.render \ () => "[max-height:20vh] [width:100vw] [max-width:100vw]"
                    |> leptos.element_to_fragment
            |> leptos.element_to_view

            leptos.td [
                "class=\"whitespace-nowrap px-4 py-2 text-gray-700 dark:text-gray-500\""
            ] \ () =>
                txn.outcomes.status
                |> sm'.obj_to_string
                |> leptos.text_fragment
            |> leptos.element_to_view

            leptos.td [
                "class=\"whitespace-nowrap px-4 py-2 text-gray-700 dark:text-gray-500\""
            ] \ () =>
                txn.transaction_hash
                |> to_string
                |> leptos.text_fragment
            |> leptos.element_to_view

            leptos.td [
                "class=\"whitespace-nowrap px-4 py-2 text-gray-700 dark:text-gray-500\""
            ] \ () =>
                    txn.included_in_block_hash
                    |> to_string
                    |> leptos.text_fragment
            |> leptos.element_to_view

            leptos.td [
                "class=\"whitespace-nowrap px-4 py-2 text-gray-700 dark:text-gray-500\""
            ] \ () =>
                    txn.receipt_id
                    |> to_string
                    |> leptos.text_fragment
            |> leptos.element_to_view
        ]

:= render account (index : i64) (transaction : txn) : _ (_ leptos.div) =
    print_static "<transaction.render>"
    leptos.log "transaction.render (1)"

    := global_state : state.global_state = leptos.use_context () |> optionm'.unwrap

    leptos.div [
        "class=\"flex flex-1 flex-col overflow-x-auto\""
    ] \ () => :>[
        ui.divider.render \ () =>
            "Transaction " ++# sm'.obj_to_string (index + 1i64)
            |> leptos.text_fragment
        |> leptos.element_to_view

        leptos.div [
            "class=\"grid flex-1 divide-y-[1px] divide-gray-500/[.10]\""
        ] \ () =>
            :>[
                ui.grid_pair.render
                    \ props => { props ?|
                        padding_class = \ () => ""
                        class = \ () => "items-center py-[4px]"
                    }
                    \ () => "Account" |> leptos.text_fragment
                    \ () =>
                        account
                        |> leptos.text_fragment
                |> leptos.element_to_view

                ui.grid_pair.render
                    \ props => { props ?|
                        padding_class = \ () => ""
                        class = \ () => "items-center py-[4px]"
                    }
                    \ () => "Block Timestamp" |> leptos.text_fragment
                    \ () =>
                        transaction.block_timestamp
                        |> sm'.from_std_string
                        |> convert.i64
                        |> date_time.format_timestamp
                        |> to_string
                        |> leptos.text_fragment
                |> leptos.element_to_view

                ui.grid_pair.render
                    \ props => { props ?|
                        padding_class = \ () => ""
                        class = \ () => "items-center py-[4px]"
                    }
                    \ () => "Predecessor" |> leptos.text_fragment
                    \ () =>
                        transaction.predecessor_account_id
                        |> to_string
                        |> leptos.text_fragment
                |> leptos.element_to_view

                ui.grid_pair.render
                    \ props => { props ?|
                        padding_class = \ () => ""
                        class = \ () => "items-center py-[4px]"
                    }
                    \ () => "Receiver" |> leptos.text_fragment
                    \ () =>
                        transaction.receiver_account_id
                        |> to_string
                        |> leptos.text_fragment
                |> leptos.element_to_view

                ui.grid_pair.render
                    \ props => { props ?|
                        padding_class = \ () => "sm:pr-[10px]"
                        class = \ () => "items-center py-[4px]"
                        dd_class = \ () => "[flex-direction:column]"
                    }
                    \ () => "Actions" |> leptos.text_fragment
                    \ () =>
                        transaction.actions
                        |> am'.to_vec
                        |> am'.vec_map \ { action method } =>
                            action_render action method
                            |> leptos.element_to_view
                        |> leptos.vec_to_view
                        |> leptos.view_to_fragment
                |> leptos.element_to_view

                ui.grid_pair.render
                    \ props => { props ?|
                        padding_class = \ () => ""
                        class = \ () => "items-center py-[4px]"
                    }
                    \ () => "Deposit" |> leptos.text_fragment
                    \ () =>
                        transaction.actions_agg.deposit
                        |> sm'.obj_to_string
                        |> leptos.text_fragment
                |> leptos.element_to_view

                ui.grid_pair.render
                    \ props => { props ?|
                        padding_class = \ () => ""
                        class = \ () => "items-center py-[4px]"
                    }
                    \ () => "Outcome Status" |> leptos.text_fragment
                    \ () =>
                        transaction.outcomes.status
                        |> sm'.obj_to_string
                        |> leptos.text_fragment
                |> leptos.element_to_view

                ui.grid_pair.render
                    \ props => { props ?|
                        padding_class = \ () => ""
                        class = \ () => "items-center py-[4px]"
                    }
                    \ () => "Fee" |> leptos.text_fragment
                    \ () =>
                        transaction.outcomes_agg.transaction_fee
                        |> sm'.obj_to_string
                        |> leptos.text_fragment
                |> leptos.element_to_view

                ui.grid_pair.render
                    \ props => { props ?|
                        padding_class = \ () => ""
                        class = \ () => "items-center py-[4px]"
                    }
                    \ () => "Block Height" |> leptos.text_fragment
                    \ () =>
                        transaction.block.block_height
                        |> sm'.obj_to_string
                        |> leptos.text_fragment
                |> leptos.element_to_view

                ui.grid_pair.render
                    \ props => { props ?|
                        padding_class = \ () => ""
                        class = \ () => "items-center py-[4px]"
                    }
                    \ () => "Hash" |> leptos.text_fragment
                    \ () =>
                        transaction.transaction_hash
                        |> to_string
                        |> leptos.text_fragment
                |> leptos.element_to_view

                ui.grid_pair.render
                    \ props => { props ?|
                        padding_class = \ () => ""
                        class = \ () => "items-center py-[4px]"
                    }
                    \ () => "Block Hash" |> leptos.text_fragment
                    \ () =>
                        transaction.included_in_block_hash
                        |> to_string
                        |> leptos.text_fragment
                |> leptos.element_to_view

                ui.grid_pair.render
                    \ props => { props ?|
                        padding_class = \ () => ""
                        class = \ () => "items-center py-[4px]"
                    }
                    \ () => "Receipt ID" |> leptos.text_fragment
                    \ () =>
                        transaction.receipt_id
                        |> to_string
                        |> leptos.text_fragment
                |> leptos.element_to_view

                ?= transaction.logs ?|
                | ;[] => [] |> leptos.view_list_to_view
                | _ =>
                    ui.grid_pair.render
                        \ props => { props ?|
                            padding_class = \ () => ""
                            class = \ () => "items-center py-[4px]"
                        }
                        \ () => "Logs" |> leptos.text_fragment
                        \ () =>
                            transaction.logs
                            |> am'.to_vec
                            |> am'.vec_map' sm'.from_std_string
                            |> am'.from_vec
                            |> \ x => x : array _
                            |> seq.of_array
                            |> sm'.concat "\n"
                            |> sm'.replace "\\n" "\n"
                            |> ui.text_block_pre.render \ () => "[max-height:20vh]"
                            |> leptos.element_to_fragment
                    |> leptos.element_to_view
            ]
        |> leptos.element_to_view
    ]
