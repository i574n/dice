:< rust.rust_operators
:< leptos
:< sm'_operators

:= render () =
    print_static "<dice_view.render>"
    leptos.log "dice_view.render (1)"

    := global_state : state.global_state = leptos.use_context () |> optionm'.unwrap

    := { accounts_txns_requests txns rpc_responses } = hooks.use_transactions.render global_state

    := roll_action = leptos.new_arc_action \ (value : heap i32) =>
        := value_log = #?*value
        leptos.log ("dice_view.render (2) / set_max_action / value: " ++# value_log)
        \ () =>
            := url = "https://rpc.mainnet.near.org"
            := body =
                {
                    jsonrpc = "2.0" |> sm'.to_std_string
                    id = "dontcare" |> sm'.to_std_string
                    method = "EXPERIMENTAL_tx_status" |> sm'.to_std_string
                    params = ;[
                        "9JgptZpFQGtUvusnoF9ysVqHXD8fXCri8mFxPTMnt3kS" |> sm'.to_std_string
                        "bowen" |> sm'.to_std_string
                    ]
                }
                |> model.near.rpc.rpc_input_box

            := result : _ _ sm'.std_string =
                url
                |> networking.new_request_post
                |> networking.request_json body
                |> networking.request_send
                |> async.await
                |> resultm.map_error' sm'.format'
                |> resultm.try'
                |> networking.response_text
                |> async.await
                |> resultm.map_error' sm'.format'
                |> resultm.try'
                |> Some
                |> Ok
                |> resultm.box
                |> leptos.log_format \ log =>
                    "dice_view.render (x) / roll_action new_arc_action / result1 / result: " ++# log

            ?= result |> resultm.unbox ?|
            | Ok (Some value) =>
                value
                |> sm'.from_std_string
                |> sm'.deserialize
                |> resultm.unbox
                |> resultm.map model.near.rpc.rpc_response_unbox
                |> resultm.map Some
            | _ => Ok None
            |> resultm.box
            |> leptos.log_format \ log => "dice_view.render (x) / roll_action new_arc_action / result2 / result: " ++# log
        |> async.new_future_move

    := roll =
        \ () =>
            roll_action
            |> leptos.arc_action_value_get
            |> optionm'.map'' resultm.unbox
            |> optionm'.unbox
            |> resultm.flatten_option
            |> resultm.map optionm'.box
            |> resultm.box
            |> leptos.log_format \ log => "dice_view.render (x) / roll new_arc_memo / result: " ++# log
        |> leptos.new_arc_memo

    := error_message =
        \ () =>
            ?= roll |> leptos.signal_get |> resultm.unbox |> resultm.map optionm'.unbox ?|
            | Ok (Some { error }) => error |> model.near.rpc.format_error
            | _ => None
            |> optionm'.box
            |> leptos.log_format \ log => "dice_view.render (x) / error_message new_arc_memo / result: " ++# log
        |> leptos.new_arc_memo

    := account =
        \ () =>
            leptos.signal_get_untracked global_state.core_state .data
            |> leptos.signal_get
            |> \ data =>
                data.account
                |> optionm'.unbox
                |> optionm.map sm'.from_std_string
        |> leptos.new_arc_memo

    := accounts =
        \ () =>
            leptos.signal_get_untracked global_state.core_state .data
            |> leptos.signal_get
            |> \ data =>
                data.accounts
                |> am'.vec_map' from_pair
                |> am'.vec_filter fst
                |> am'.vec_map' snd
                |> am'.vec_mapi \ (i : i32) account =>
                    new_pair
                        i
                        (leptos.create_signal account)
        |> leptos.new_arc_memo

    := accounts_data =
        \ () =>
            accounts
            |> leptos.signal_get
            |> am'.vec_map' from_pair
            |> am'.vec_map' \ i, x =>
                i, x |> fst
        |> leptos.new_arc_memo

    :>[
        ui.accordion.render
            \ props => { props ?|
                title = \ () => "Roll"
                summary_class = \ () => "py-[7px]"
            }
            \ () => :>[
                leptos.div [
                    $'"class=\\\"flex flex-col p-[10px] gap-[11px]\\\""'
                ] \ () =>
                    :>[
                        leptos.div [
                            $'"class=\\\"flex [flex-direction:column] [gap:2px] [align-items:flex-start]\\\""'
                        ] \ () =>
                            :>[
                                "Account" |> leptos.text_view

                                ui.dropdown.render \ props => { props ?|
                                    data = accounts_data |> Some |> optionm'.box
                                    item = account |> Some |> optionm'.box
                                    select = \ (i, value) =>
                                        := data =
                                            leptos.signal_get_untracked global_state.core_state .data
                                            |> leptos.signal_get_untracked
                                            |> \ data => !data

                                        leptos.signal_get_untracked global_state.core_state .data
                                        |> leptos.signal_set (heap { data ?|
                                            account = value |> sm'.to_std_string |> Some |> optionm'.box
                                        })
                                }
                                |> leptos.element_to_view
                            ]
                        |> leptos.element_to_view

                        leptos.div [
                            $'"class=\\\"flex [flex-direction:column] [gap:2px] [align-items:flex-start]\\\""'
                        ] \ () =>
                            :>[
                                "Max" |> leptos.text_view

                                ui.text_input.render
                                    \ () => ""
                                    [
                                    ]
                                    \ () =>
                                        leptos.signal_get_untracked global_state.core_state .data
                                        |> leptos.signal_get_untracked
                                        |> \ x => x.max

                                    \ value =>
                                        := data =
                                            leptos.signal_get_untracked global_state.core_state .data
                                            |> leptos.signal_get_untracked
                                            |> \ data => !data

                                        leptos.signal_get_untracked global_state.core_state .data
                                        |> leptos.signal_set (heap { data ?|
                                            max =
                                                ?= value |> sm'.obj_to_string ?|
                                                | "" => 1
                                                | x => x |> convert.i32
                                        })
                                |> leptos.element_to_view
                            ]
                        |> leptos.element_to_view

                        leptos.div [
                            $'"class=\\\"flex\\\""'
                        ] \ () =>
                            :>[
                                ui.loading_button.render
                                    "Roll"
                                    (roll_action |> leptos.arc_action_pending_fn)
                                    \ () =>
                                        := max =
                                            leptos.signal_get_untracked global_state.core_state .data
                                            |> leptos.signal_get_untracked
                                            |> \ x => heap x.max

                                        roll_action |> leptos.arc_action_dispatch max
                                |> leptos.element_to_view

                                leptos.reactive_view \ () =>
                                    ?= error_message |> leptos.signal_get |> optionm'.unbox ?|
                                    | Some error_message =>
                                        error_message
                                        |> ui.error_label.render
                                        |> leptos.element_to_view
                                    | _ => [] |> leptos.view_list_to_view
                            ]
                        |> leptos.element_to_view
                ]
            ]
        |> leptos.element_to_view

        ui.accordion.render
            \ props => { props ?|
                title = \ () => "History"
                summary_class = \ () => "py-[7px]"
            }
            \ () => :>[
                leptos.reactive_view \ () =>
                    ?= accounts_txns_requests |> leptos.signal_get |> am'.from_vec ?|
                    | (array ;[] : array _) =>
                        "No account selected"
                        |> ui.error_label.render
                        |> leptos.element_to_view
                    | _ =>
                        txns
                        |> leptos.signal_get
                        |> resultm.unbox
                        |> resultm.map optionm'.unbox
                        |> \|
                            | Ok (Some transactions) =>
                                := transactions =
                                    transactions
                                    |> am'.to_vec
                                    |> am'.vec_filter \|
                                        | { account txn } =>
                                            := is_call =
                                                txn.actions
                                                |> am'.to_vec
                                                |> am'.vec_map' \ transaction =>
                                                    {
                                                        action =
                                                            transaction.action
                                                            |> sm'.from_std_string
                                                        method =
                                                            transaction.method
                                                            |> optionm'.unbox
                                                            |> optionm.map sm'.from_std_string
                                                    }
                                                |> am'.vec_filter \ transaction =>
                                                    {
                                                        action = "FUNCTION_CALL"
                                                        method = Some "generate_random_number"
                                                    } = transaction
                                                |> am'.from_vec
                                                |> \ (x : array _) => length x > 0
                                            := is_receiver =
                                                account = (txn.receiver_account_id |> sm'.from_std_string)
                                            is_call && is_receiver
                                        | _ => !-

                                ui.table.render
                                    (
                                        leptos.tr [

                                        ] \ () =>
                                            :>[
                                                leptos.th [
                                                    $'"class=\\\"whitespace-nowrap px-4 py-2 font-medium \
                                                        text-gray-900 dark:text-white\\\""'
                                                ] \ () =>
                                                    "Block Timestamp" |> leptos.text_fragment
                                                |> leptos.element_to_view

                                                leptos.th [
                                                    $'"class=\\\"whitespace-nowrap px-4 py-2 font-medium \
                                                        text-gray-900 dark:text-white\\\""'
                                                ] \ () =>
                                                    "Predecessor" |> leptos.text_fragment
                                                |> leptos.element_to_view

                                                leptos.th [
                                                    $'"class=\\\"whitespace-nowrap px-4 py-2 font-medium \
                                                        text-gray-900 dark:text-white\\\""'
                                                ] \ () =>
                                                    "Receiver" |> leptos.text_fragment
                                                |> leptos.element_to_view

                                                leptos.th [
                                                    $'"class=\\\"whitespace-nowrap px-4 py-2 font-medium \
                                                        text-gray-900 dark:text-white\\\""'
                                                ] \ () =>
                                                    "Fee" |> leptos.text_fragment
                                                |> leptos.element_to_view

                                                leptos.th [
                                                    $'"class=\\\"whitespace-nowrap px-4 py-2 font-medium \
                                                        text-gray-900 dark:text-white\\\""'
                                                ] \ () =>
                                                    "Result" |> leptos.text_fragment
                                                |> leptos.element_to_view

                                                leptos.th [
                                                    $'"class=\\\"whitespace-nowrap px-4 py-2 font-medium \
                                                        text-gray-900 dark:text-white\\\""'
                                                ] \ () =>
                                                    "Status" |> leptos.text_fragment
                                                |> leptos.element_to_view
                                            ]
                                        |> leptos.element_to_fragment
                                    )
                                    (
                                        := rpc_responses =
                                            rpc_responses
                                            |> leptos.signal_get
                                        transactions
                                        |> am'.vec_map \ { txn i } =>
                                            := rpc_response =
                                                rpc_responses |> am'.from_vec |> am'.index (i |> convert.i32)

                                            leptos.tr [
                                                $'"class=\\\"odd:bg-gray-50 dark:odd:bg-gray-800/50\\\""'
                                            ] \ () =>
                                                :>[
                                                    leptos.td [
                                                        $'"class=\\\"whitespace-nowrap px-4 py-2 text-gray-700 \
                                                            dark:text-gray-500\\\""'
                                                    ] \ () =>
                                                        txn.block_timestamp
                                                        |> sm'.from_std_string
                                                        |> convert.i64
                                                        |> date_time.format_timestamp
                                                        |> to_string
                                                        |> leptos.text_fragment
                                                    |> leptos.element_to_view

                                                    leptos.td [
                                                        $'"class=\\\"whitespace-nowrap px-4 py-2 text-gray-700 \
                                                            dark:text-gray-500\\\""'
                                                    ] \ () =>
                                                        txn.predecessor_account_id
                                                        |> to_string
                                                        |> leptos.text_fragment
                                                    |> leptos.element_to_view

                                                    leptos.td [
                                                        $'"class=\\\"whitespace-nowrap px-4 py-2 text-gray-700 \
                                                            dark:text-gray-500\\\""'
                                                    ] \ () =>
                                                        txn.receiver_account_id
                                                        |> to_string
                                                        |> leptos.text_fragment
                                                    |> leptos.element_to_view

                                                    leptos.td [
                                                        $'"class=\\\"whitespace-nowrap px-4 py-2 text-gray-700 \
                                                            dark:text-gray-500\\\""'
                                                    ] \ () =>
                                                        txn.outcomes_agg.transaction_fee
                                                        |> sm'.obj_to_string
                                                        |> leptos.text_fragment
                                                    |> leptos.element_to_view

                                                    leptos.td [
                                                        $'"class=\\\"whitespace-nowrap px-4 py-2 text-gray-700 \
                                                            dark:text-gray-500\\\""'
                                                    ] \ () =>
                                                        ?= txn.logs ?|
                                                        | ;[] => "" |> leptos.text_fragment
                                                        | _ =>
                                                            ((array txn.logs : array _), None)
                                                            ||> arraym.foldBack \ x acc =>
                                                                := logs =
                                                                    x
                                                                    |> sm'.from_std_string
                                                                    |> sm'.split " / result: "
                                                                ?= acc, logs ?|
                                                                | None, ;[ _; result ] => Some result
                                                                | _ => acc
                                                            |> optionm'.default_value "?"
                                                            |> leptos.text_fragment
                                                    |> leptos.element_to_view

                                                    leptos.td [
                                                        $'"class=\\\"whitespace-nowrap px-4 py-2 text-gray-700 \
                                                            dark:text-gray-500\\\""'
                                                    ] \ () =>
                                                        ? txn.outcomes.status
                                                        ?> "Ok"
                                                        |: "Outcome Error"
                                                        |> \ s =>
                                                            rpc_response
                                                            |> resultm.unbox
                                                            |> resultm.map optionm'.unbox
                                                            |> \|
                                                                | Ok (Some ({ error } &= rpc_response)) =>
                                                                    ?= error |> optionm'.unbox ?|
                                                                    | Some _ =>
                                                                        error
                                                                        |> model.near.rpc.format_error
                                                                        |> optionm'.default_with sm'.format_ellipsis
                                                                        |> Error
                                                                    | None =>
                                                                        rpc_response
                                                                        |> sm'.format_ellipsis
                                                                        |> Ok
                                                                | Error error =>
                                                                    error
                                                                    |> sm'.from_std_string
                                                                    |> Error
                                                                | rpc_response =>
                                                                    rpc_response
                                                                    |> sm'.format_ellipsis
                                                                    |> \ rpc_response_log =>
                                                                        "RPC Response: " ++# rpc_response_log
                                                                    |> Error
                                                                |> \|
                                                                    | Ok rpc_response =>
                                                                        rpc_response
                                                                        |> sm'.format_ellipsis
                                                                        |> \ rpc_response_log =>
                                                                            "RPC Response: " ++# rpc_response_log
                                                                    | Error error =>
                                                                        "Error: " ++# error
                                                            |> \ (rpc_response_log : string) =>
                                                                s ++# " / " ++# rpc_response_log
                                                        |> leptos.text_fragment
                                                    |> leptos.element_to_view
                                                ]
                                            |> leptos.element_to_view
                                        |> leptos.vec_to_view
                                        |> leptos.view_to_fragment
                                    )
                                    |> leptos.element_to_view
                            | Error error =>
                                error
                                |> sm'.from_std_string
                                |> ui.error_label.render
                                |> leptos.element_to_view
                            | _ =>
                                ui.loading_panel.render ()
                                |> leptos.element_to_view
            ]
        |> leptos.element_to_view
    ]
