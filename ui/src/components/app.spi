:< rust.rust_operators
:< leptos

:= render () =
    print_static "<app.render>"
    leptos.log "app.render ()"

    leptos.provide_meta_context ()

    := global_state : state.global_state =
        heap {
            core_state =
                leptos.new_arc_rw_signal <|
                    heap {
                        dark_mode = leptos.new_arc_rw_signal !-
                        debug = leptos.new_arc_rw_signal !-
                        url_hash = leptos.new_arc_rw_signal ("" |> sm'.to_std_string)
                        data =
                            leptos.new_arc_rw_signal <|
                                heap {
                                    accounts =
                                        am'.base ;[
                                            new_pair !+ ("i574n.near" |> sm'.to_std_string)
                                            new_pair !+ ("luckier.near" |> sm'.to_std_string)
                                        ]
                                        |> am'.to_vec
                                    account = None |> optionm'.box
                                    max = 1
                                    transactions_pages = 1
                                    transactions_view_type = state.Details
                                }
                    }
            loading = mapm.new_hash_map () |> leptos.new_arc_rw_signal
        }

    \ () =>
        :< state
        ~> leptos.provide_context `global_state global_state
    |> \ x => x ()

    := home_view (router : i32) : leptos.view = home.render { router } |> leptos.element_to_view
    := home_view = ~~ home_view
    leptos.router (
        leptos.routes (\ () => home_view 4) [
            leptos.route "" \ () => home_view 1
            leptos.route "/*any" \ () => home_view 3
        ]
    )
